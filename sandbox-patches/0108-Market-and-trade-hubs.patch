From 96b357ef733e095e3786adfb9b896ecc8e6a97a3 Mon Sep 17 00:00:00 2001
From: AzediZ <145237384+AzediZ@users.noreply.github.com>
Date: Wed, 21 Oct 2026 21:13:38 +0000
Subject: [PATCH 108/110] Market and trade hubs

Every blueprint an NPC corporation sells is offered at every trade hub
in <marketSim> Hubs as well as at the corp's own stations, at its base
price, by the hub's own corp where it trades it, else the lowest corp
that does.  Before, Amarr and Rens had 2 blueprint types and Dodixie
none.  What no NPC corp trades (tech two, faction, pirate blueprints)
stays out.

The market sim no longer sells what no NPC sold on Tranquility:
capital ships that can't enter high security (carriers, dreadnoughts,
supercarriers, titans, the Rorqual), the alliance tournament prize
ships, the gift ships and the Imperial Issue battleships.  Their sim
orders go when it starts.

Fixes rolled in:
- buy order escrow at a player corp's station no longer goes through
  the corp's wallet (an SQL error that dropped the database connection,
  and NotEnoughMoneyCorp when paying a seller)
---
 src/eve-server/account/AccountService.cpp | 10 +++--
 src/eve-server/market/sim/MarketSimDB.cpp | 46 +++++++++++++++++++++++
 src/eve-server/market/sim/SimStaticData.h | 26 ++++++++++++-
 3 files changed, 77 insertions(+), 5 deletions(-)

diff --git a/src/eve-server/account/AccountService.cpp b/src/eve-server/account/AccountService.cpp
index 2f3a939..3628e89 100644
--- a/src/eve-server/account/AccountService.cpp
+++ b/src/eve-server/account/AccountService.cpp
@@ -489,7 +489,7 @@ void AccountService::TransferFunds(
             reason,
             referenceID
         );
-    } else if (IsPlayerCorp(fromID)) {
+    } else if (IsPlayerCorp(fromID) and (fromKey != Account::KeyType::Escrow)) {
         uint32 userID(0);
         if (pClient != nullptr) {
             userID = pClient->GetCharacterID();
@@ -506,7 +506,9 @@ void AccountService::TransferFunds(
             reason,
             referenceID
         );
-    } // fromID could be npc or _System.  nothing to do on this side.
+    } /* fromID could be npc or _System.  nothing to do on this side.  nor for escrow held at a player corp's station:  the market holds
+       *  it, not the station's owner (its wallet has no escrow division, and paying the seller out of it failed)
+       */
 
     uint8 toCurrency = Account::CreditType::ISK;
     if (IsAUR(toKey)) {
@@ -542,7 +544,7 @@ void AccountService::TransferFunds(
                 reason,
                 referenceID
             );
-        } else if (IsPlayerCorp(toID)) {
+        } else if (IsPlayerCorp(toID) and (toKey != Account::KeyType::Escrow)) {
             uint32 userID(0);
 
             if (pClient != nullptr) {
@@ -685,7 +687,7 @@ void AccountService::RefundSender(uint32 fromID, uint32 toID, double amount, uin
                 newBalance = pClientFrom->GetBalance(fromCurrency);
             }
             AccountDB::AddJournalEntry(fromID, entryTypeID, toID, fromID, fromCurrency, fromKey, amount, newBalance, refund, referenceID);
-        } else if (IsPlayerCorp(fromID)) {
+        } else if (IsPlayerCorp(fromID) and (fromKey != Account::KeyType::Escrow)) {
             HandleCorpTransaction(fromID, entryTypeID, toID, fromID, fromCurrency, fromKey, amount, refund, referenceID);
         }
     } catch (...) {
diff --git a/src/eve-server/market/sim/MarketSimDB.cpp b/src/eve-server/market/sim/MarketSimDB.cpp
index afcdbfe..8eb8f2b 100644
--- a/src/eve-server/market/sim/MarketSimDB.cpp
+++ b/src/eve-server/market/sim/MarketSimDB.cpp
@@ -166,6 +166,14 @@ size_t MarketSimDB::LoadCalibration(StaticData& data, const std::set<uint32>& re
         // PLEX and Apparel are players' only (simClass 0), whatever the calibration says
         if ((t.typeID == 29668) or (t.categoryID == Category::Apparel))
             t.simClass = SimClass::Excluded;
+        /* ...and so are the capital ships that may not enter high security (carriers, dreadnoughts, supercarriers, titans,
+         *  the Rorqual):  the sim trades at the trade hubs, all high security, and on Tranquility those are only ever sold in
+         *  low and null security, where they're built.  their orders go as the sim starts (no cell backs them) */
+        if (Group::KeptOutOfHighSec((uint16_t)t.groupID))
+            t.simClass = SimClass::Excluded;
+        // ...and the alliance tournament prize ships and the gift ships, which no NPC ever sold
+        if (PrizeOrGiftShip(t.typeID))
+            t.simClass = SimClass::Excluded;
         data.types[t.typeID] = t;
     }
 
@@ -294,6 +302,7 @@ void MarketSimDB::LoadVendorOffers(StaticData& data, const std::string& mode, co
         codelog(MARKET__DB_ERROR, "Error in query: %s", res.error.c_str());
         return;
     }
+    std::set<std::pair<uint32, uint32>> offered;
     while (res.GetRow(row)) {
         VendorOffer o = VendorOffer();
         o.corpID = row.GetUInt(0);
@@ -302,6 +311,43 @@ void MarketSimDB::LoadVendorOffers(StaticData& data, const std::string& mode, co
         o.systemID = row.GetUInt(3);
         o.regionID = row.GetUInt(4);
         data.vendors.push_back(o);
+        offered.insert(std::make_pair(o.typeID, o.stationID));
+    }
+    if (mode == "hubsOnly")
+        return;
+    /* every blueprint the npc corps sell, at every hub too:  a corp's own stations in its home region carried
+     *  few of them at a hub (2 at Amarr, none at Dodixie), so a pilot shopping at one found almost none.  sold by the
+     *  hub's own corp where it trades the blueprint, else the lowest corp that does.  what no npc corp trades (tech two,
+     *  faction and pirate blueprints) stays out
+     */
+    std::string list;
+    for (auto h : hubs)
+        list += (list.empty() ? "" : ",") + std::to_string(h);
+    if (list.empty())
+        return;
+    if (!sDatabase.RunQuery(res,
+        "SELECT IFNULL(MAX(IF(t.corporationID = s.corporationID, t.corporationID, NULL)), MIN(t.corporationID)),"
+        " t.typeID, s.stationID, s.solarSystemID, s.regionID"
+        " FROM crpNPCCorporationTrades t"
+        " JOIN mktCalType c ON c.typeID = t.typeID AND c.simClass = %u"
+        " JOIN invTypes i ON i.typeID = t.typeID"
+        " JOIN invGroups g ON g.groupID = i.groupID AND g.categoryID = %u"
+        " JOIN staStations s ON s.stationID IN (%s)"
+        " GROUP BY t.typeID, s.stationID ORDER BY t.typeID, s.stationID",
+        SimClass::NpcVendor, EVEDB::invCategories::Blueprint, list.c_str()))
+    {
+        codelog(MARKET__DB_ERROR, "Error in query: %s", res.error.c_str());
+        return;
+    }
+    while (res.GetRow(row)) {
+        VendorOffer o = VendorOffer();
+        o.corpID = row.GetUInt(0);
+        o.typeID = row.GetUInt(1);
+        o.stationID = row.GetUInt(2);
+        o.systemID = row.GetUInt(3);
+        o.regionID = row.GetUInt(4);
+        if (offered.insert(std::make_pair(o.typeID, o.stationID)).second)
+            data.vendors.push_back(o);
     }
 }
 
diff --git a/src/eve-server/market/sim/SimStaticData.h b/src/eve-server/market/sim/SimStaticData.h
index 03b5f64..32df90c 100644
--- a/src/eve-server/market/sim/SimStaticData.h
+++ b/src/eve-server/market/sim/SimStaticData.h
@@ -96,8 +96,32 @@ namespace MktSim {
         enum : uint16_t {
             MiningBarge     = 463,
             Exhumer         = 543,
-            Ice             = 465
+            Ice             = 465,
+            // the capital ships that may not enter high security
+            Titan           = 30,
+            Dreadnought     = 485,
+            Carrier         = 547,
+            Supercarrier    = 659,
+            CapitalIndustrial = 883     // the Rorqual
         };
+        inline bool KeptOutOfHighSec(uint16_t groupID)  { return (groupID == Titan) or (groupID == Dreadnought) or (groupID == Carrier)
+                                                                 or (groupID == Supercarrier) or (groupID == CapitalIndustrial); }
+    }
+
+    // the alliance tournament's prize ships and the ships given away to players:  never sold by an NPC on Tranquility
+    inline bool PrizeOrGiftShip(uint32_t typeID) {
+        switch (typeID) {
+            case 11940: case 11942:     // Gold Magnate, Silver Magnate
+            case 11011:                 // Guardian-Vexor
+            case 3516:  case 3518:      // Malice, Vangel
+            case 2834:  case 2836:      // Utu, Adrestia
+            case 32207: case 32209:     // Freki, Mimir
+            case 2078:  case 3532:      // Zephyr, Echelon
+            case 29266: case 2863:      // Apotheosis, Primae
+            case 11936: case 11938:     // Apocalypse Imperial Issue, Armageddon Imperial Issue:  the Emperor's gifts
+                return true;
+        }
+        return false;
     }
 
     // mktCalGroup.  NaN = not set (the plan's default is used)
