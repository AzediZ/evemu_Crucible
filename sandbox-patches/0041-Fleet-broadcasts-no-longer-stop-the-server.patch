From 7970f695c6289e14e257a2f836771326bd9ea6d4 Mon Sep 17 00:00:00 2001
From: AzediZ <145237384+AzediZ@users.noreply.github.com>
Date: Wed, 14 Oct 2026 14:50:11 +0000
Subject: [PATCH 41/50] Fleet: broadcasts no longer stop the server

FleetBroadcast() built a 5-slot tuple and then set slot 6 (the broadcast name).  PyTuple::SetItem uses
vector::at, which threw std::out_of_range, and nothing caught it, so any fleet broadcast (Need Backup,
Align To, Target...) stopped the server.
---
 src/eve-server/fleet/FleetService.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/eve-server/fleet/FleetService.cpp b/src/eve-server/fleet/FleetService.cpp
index 3228cf1c..94f573e9 100644
--- a/src/eve-server/fleet/FleetService.cpp
+++ b/src/eve-server/fleet/FleetService.cpp
@@ -2487,7 +2487,9 @@ void FleetService::FleetBroadcast(Client* pFrom, uint32 itemID, int8 scope, int8
     //OnFleetBroadcast(name, group, charID, solarSystemID, itemID):
     //   ('HealCapacitor', 3, 95895066, 30003500, 1019274373727L, None)))
 
-    PyTuple* payload = new PyTuple(5);
+    // six items:  the broadcast name is the sixth.  a 5-slot tuple threw std::out_of_range on SetItem(5), and nothing
+    //  caught it, so every fleet broadcast stopped the server
+    PyTuple* payload = new PyTuple(6);
         payload->SetItem(0, new PyString(msg));
         payload->SetItem(1, new PyInt(group));
         payload->SetItem(2, new PyInt(pFrom->GetCharacterID()));
