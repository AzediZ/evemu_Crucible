--- a/src/eve-server/ship/Missile.cpp
+++ b/src/eve-server/ship/Missile.cpp
@@ -37,6 +37,8 @@
 #include "ship/Ship.h"
 #include "ship/modules/GenericModule.h"
 #include "system/Damage.h"
