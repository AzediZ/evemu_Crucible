+void ShipSE::ReleaseDrone(DroneSE* pDrone) {
+    if (pDrone == nullptr)
+        return;
+    std::map<uint32, InventoryItem*>::iterator itr = m_drones.find(pDrone->GetID());
+    if (itr == m_drones.end())
+        return;
+    m_drones.erase(itr);
+    m_scoopQueue.erase(pDrone->GetID());
+    EvilNumber load = m_shipRef->GetAttribute(AttrDroneBandwidthLoad);
+    load -= pDrone->GetSelf()->GetAttribute(AttrDroneBandwidthUsed);
+    if (load.get_float() < 0)
+        load = EvilZero;
+    m_shipRef->SetAttribute(AttrDroneBandwidthLoad, load, false); // client dont care
+}
+
+bool ShipSE::ReconnectDrone(DroneSE* pDrone) {
+    Client* pClient(GetPilot());
+    if ((pClient == nullptr) or (pDrone == nullptr))
+        return false;
+    if (m_drones.find(pDrone->GetID()) != m_drones.end())
+        return true;
+    if (MaxActiveDrones() <= m_drones.size())
+        return false;
+    EvilNumber load = m_shipRef->GetAttribute(AttrDroneBandwidthLoad);
+    load += pDrone->GetSelf()->GetAttribute(AttrDroneBandwidthUsed);
+    if (!(load <= m_shipRef->GetAttribute(AttrDroneBandwidth)))
+        return false;
+    m_shipRef->SetAttribute(AttrDroneBandwidthLoad, load, false); // client dont care
+    m_drones.emplace(pDrone->GetID(), pDrone->GetSelf().get());
+    pDrone->Online(this);
+    pDrone->GetAI()->SetIdle();
+    return true;
+}
+
+void ShipSE::DropAllDrones() {
+    m_scoopQueue.clear();
+    if (m_drones.empty())
+        return;
+    std::vector<uint32> ids;
+    for (auto cur : m_drones)
+        ids.push_back(cur.first);
+    m_drones.clear();
+    m_shipRef->SetAttribute(AttrDroneBandwidthLoad, EvilZero, false); // client dont care
+    if (m_system == nullptr)
+        return;
+    for (auto id : ids) {
+        SystemEntity* pSE(m_system->GetSE(id));
+        if ((pSE != nullptr) and pSE->IsDroneSE())
+            pSE->GetDroneSE()->LoseControl();
+    }
+}
+
+void ShipSE::ProcessDroneScoops() {
+    if (m_scoopQueue.empty())
+        return;
+    std::set<uint32> queue;
+    queue.swap(m_scoopQueue);
+    Client* pClient(GetPilot());
+    if ((pClient == nullptr) or (m_system == nullptr))
+        return;
+    for (auto id : queue) {
+        SystemEntity* pSE(m_system->GetSE(id));
+        if ((pSE == nullptr) or !pSE->IsDroneSE())
+            continue;
+        DroneSE* pDrone(pSE->GetDroneSE());
+        if (pDrone->GetControllerID() != GetID())
+            continue;
+        InventoryItemRef iRef(pSE->GetSelf());
+        bool fits(false);
+        try {
+            m_shipRef->VerifyHoldType(flagDroneBay, iRef, pClient);
+            fits = m_shipRef->GetMyInventory()->ValidateAddItem(flagDroneBay, iRef);
+        } catch (...) {
+            fits = false;
+        }
+        if (!fits) {
+            pClient->SendNotifyMsg("There is no room in your drone bay for the %s, so it will stay out and orbit your ship.", pSE->GetName());
+            pDrone->GetAI()->Return();
+            continue;
+        }
+        iRef->ChangeOwner(pClient->GetCharacterID(), true);
+        pClient->MoveItem(iRef->itemID(), pClient->GetShipID(), flagDroneBay);
+        ScoopDrone(pSE);
+        m_system->RemoveEntity(pSE);
+        SafeDelete(pSE);
+    }
+}
+
+uint32 ShipSE::MaxActiveDrones() {
+    Client* pClient(GetPilot());
+    if (pClient == nullptr)
+        return 0;
+    uint32 count(pClient->GetChar()->GetAttribute(AttrMaxActiveDrones).get_uint32());
+    // carriers and supercarriers control extra drones per carrier skill level.  only add it here
+    // if the effects system has not already folded it into the character's attribute.
+    if (count > pClient->GetChar()->GetSkillLevel(EvESkill::Drones))
+        return count;
+    struct { uint16 attr; uint16 skill; } races[] = {
+        { AttrCarrierAmarrBonus1, 24311 }, { AttrCarrierCaldariBonus1, 24312 },
+        { AttrCarrierGallenteBonus1, 24313 }, { AttrCarrierMinmatarBonus1, 24314 } };
+    for (auto race : races) {
+        if (m_shipRef->HasAttribute(race.attr)) {
+            count += m_shipRef->GetAttribute(race.attr).get_uint32() * pClient->GetChar()->GetSkillLevel(race.skill);
+            break;
+        }
+    }
+    return count;
+}
+
+double ShipSE::CarrierDroneDamageMultiplier() {
+    Client* pClient(GetPilot());
+    if (pClient == nullptr)
+        return 1.0;
+    // only Caldari and Gallente carriers have a drone and fighter damage bonus
+    if ((m_shipRef->groupID() != EVEDB::invGroups::Carrier) and (m_shipRef->groupID() != EVEDB::invGroups::Supercarrier))
+        return 1.0;
+    if (m_shipRef->HasAttribute(AttrCarrierCaldariBonus2))
+        return 1.0 + (m_shipRef->GetAttribute(AttrCarrierCaldariBonus2).get_float() * pClient->GetChar()->GetSkillLevel(24312) / 100.0);
+    if (m_shipRef->HasAttribute(AttrCarrierGallenteBonus2))
+        return 1.0 + (m_shipRef->GetAttribute(AttrCarrierGallenteBonus2).get_float() * pClient->GetChar()->GetSkillLevel(24313) / 100.0);
+    return 1.0;
+}
