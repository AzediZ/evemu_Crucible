+    for (auto cur : lockers) {
+        if (!IsHostile(cur))
+            continue;
+        double distance(m_pDrone->GetPosition().distance(cur->GetPosition()));
+        if ((pBest == nullptr) or (distance < bestDistance)) {
+            pBest = cur;
+            bestDistance = distance;
+        }
+    }
+    return pBest;
