+ShipSE* DroneSE::GetControllerShip() {
+    ShipSE* pShip(FindControllerShip());
+    if (pShip == nullptr)
+        return nullptr;
+    if (!pShip->HasPilot() or (pShip->GetPilot()->GetCharacterID() != m_ownerID))
+        return nullptr;
+    return pShip;
+}
+
+ShipSE* DroneSE::CheckControl() {
+    if (!m_online)
+        return nullptr;
+    ShipSE* pShip(GetControllerShip());
+    if (pShip == nullptr) {
+        // controlling ship docked, jumped, was destroyed or lost its pilot
+        LoseControl();
+        return nullptr;
+    }
+    if (pShip->SysBubble() == nullptr)
+        return nullptr;     // ship is mid-transition; try again next tick
+    return pShip;
+}
+
+void DroneSE::LoseControl() {
+    _log(DRONE__TRACE, "Drone %s(%u) lost contact with controller %u", GetName(), GetID(), m_controllerID);
+    ShipSE* pShip(FindControllerShip());
+    if (pShip != nullptr)
+        pShip->ReleaseDrone(this);
+    if (TargetMgr() != nullptr)
+        TargetMgr()->ClearTargets();
+    m_controllerID = 0;
+    m_controllerOwnerID = 0;
+    m_targetID = 0;
+    m_pShipSE = nullptr;
+    Offline(false);
+}
+
