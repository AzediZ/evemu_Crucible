From e68b3299d9326224f409c5d9a7739e3962419999 Mon Sep 17 00:00:00 2001
From: AzediZ <145237384+AzediZ@users.noreply.github.com>
Date: Thu, 15 Oct 2026 16:50:22 +0000
Subject: [PATCH 82/91] Repackaging: rigs are destroyed, modules come off
 properly, full containers refused

- Repackaging a ship destroys its rigs, as in Crucible. Before, the cargo pass
  moved everything in the ship to the hangar first, rigs included, so they came
  back intact.
- Modules, subsystems and loaded charges are taken off through the module
  manager when the ship was boarded this session, before its holds are emptied.
  Weapon banks and insurance go as before.
- The pilot is told what happened: modules and cargo moved to the hangar, rigs
  destroyed.
- A container (or anything else with contents that isn't a ship) has to be
  empty before it can be repackaged. Before, its contents were lost inside
  the package.
---
 src/eve-server/ship/Ship.cpp             | 26 ++++++++++++++++++++++
 src/eve-server/ship/Ship.h               |  3 +++
 src/eve-server/station/RepairService.cpp | 28 +++++++++++++++++++-----
 3 files changed, 52 insertions(+), 5 deletions(-)

diff --git a/src/eve-server/ship/Ship.cpp b/src/eve-server/ship/Ship.cpp
index db564fb88..9c83af815 100644
--- a/src/eve-server/ship/Ship.cpp
+++ b/src/eve-server/ship/Ship.cpp
@@ -1624,6 +1624,32 @@ void ShipItem::EvictExcessModules()
     }
 }
 
+uint8 ShipItem::PrepareRepackage()
+{
+    UnlinkAllWeapons(true);
+
+    std::vector<InventoryItemRef> items;
+    // a ship boarded this session has module objects:  take them off first (charges are unloaded into the cargo hold)
+    pInventory->GetInventoryVec(items);
+    for (auto cur : items)
+        if ((IsModuleSlot(cur->flag()) or IsRigSlot(cur->flag()) or IsSubSystem(cur->flag()))
+        and (m_ModuleManager->GetModule(cur->itemID()) != nullptr))
+            m_ModuleManager->UnfitModule(cur->itemID());
+
+    uint8 rigs(0);
+    items.clear();
+    pInventory->GetInventoryVec(items);
+    for (auto cur : items) {
+        if (IsRigSlot(cur->flag())) {
+            ++rigs;
+            cur->Delete();
+            continue;
+        }
+        cur->Move(locationID(), flagHangar, true);
+    }
+    return rigs;
+}
+
 void ShipItem::EmptyCargo()
 {
     std::map<uint32, InventoryItemRef> invMap;
diff --git a/src/eve-server/ship/Ship.h b/src/eve-server/ship/Ship.h
