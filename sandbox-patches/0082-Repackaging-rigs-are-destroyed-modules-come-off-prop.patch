--- a/src/eve-server/ship/Ship.h
+++ b/src/eve-server/ship/Ship.h
@@ -141,6 +141,9 @@ public:
     void StripFitting(bool all=false);
     // this will remove all items from all ship cargo holds
     void EmptyCargo();
+    /* repackaging (RepairService::UnasembleItems):  fitted modules and subsystems come off, rigs are destroyed, and charges,
+     *  drones and every hold's contents go to the hangar.  returns how many rigs were destroyed */
+    uint8 PrepareRepackage();
     // after a subsystem change: modules past the ship's slots or hardpoints go to the hangar (cargo in space)
     void EvictExcessModules();
     // after a pilot change: shield/capacitor charge and armor/structure damage are cut to the new capacities
diff --git a/src/eve-server/station/RepairService.cpp b/src/eve-server/station/RepairService.cpp
index 5e0eac703..66bcf3626 100644
--- a/src/eve-server/station/RepairService.cpp
+++ b/src/eve-server/station/RepairService.cpp
@@ -223,6 +223,12 @@ PyResult RepairService::UnasembleItems(PyCallArgs& call, PyDict* validIDsByStati
             // an audit log container with a log entry less than three weeks old
             if (ContainerSecurity::IsAuditLog(iRef) and sContSec.HasRecentLog(itemID, GetFileTimeNow() - (Win32Time_Day * 21)))
                 throw UserError("CanNotRepackageALSC");
+            // a container's contents would be lost inside the package
