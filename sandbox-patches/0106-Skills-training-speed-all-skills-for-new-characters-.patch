     //spawn all the skills
     uint8 skillLevel = 0;
@@ -346,6 +364,9 @@ PyResult CharUnboundMgrService::CreateCharacterWithDoll(PyCallArgs &call, PyRep*
         skill->SetAttribute(AttrSkillPoints, skillPoints, false);
