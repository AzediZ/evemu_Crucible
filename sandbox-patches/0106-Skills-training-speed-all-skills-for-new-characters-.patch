diff --git a/src/eve-server/character/Character.cpp b/src/eve-server/character/Character.cpp
index 748dcef..d75fe47 100644
--- a/src/eve-server/character/Character.cpp
+++ b/src/eve-server/character/Character.cpp
@@ -391,6 +391,10 @@ CharacterRef Character::Spawn( CharacterData& charData, CorpData& corpData) {
 void Character::LogOut()
 {
     SaveFullCharacter();
