+SystemEntity* IncursionMgr::FindItem(IncLiveSite& site, SystemManager* pSys, uint16 typeID)
+{
+    for (auto& cur : site.items)
+        if (cur.typeID == typeID) {
+            SystemEntity* pSE = pSys->GetSE(cur.itemID);
+            if (pSE != nullptr)
+                return pSE;
+        }
+    return nullptr;
+}
