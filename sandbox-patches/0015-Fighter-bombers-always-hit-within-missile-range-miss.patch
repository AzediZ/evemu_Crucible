From c1bd9f0d78d9edcdc31e482956ecbe0c2e2f750f Mon Sep 17 00:00:00 2001
From: AzediZ <145237384+AzediZ@users.noreply.github.com>
Date: Sun, 11 Oct 2026 20:07:38 +0100
Subject: [PATCH] Fighter bombers: always hit within missile range,
 missile-style damage, capital targets only

Bombers have no turret stats (maxRange, falloff, trackingSpeed), so GetDroneToHit
treated every target as beyond a zero optimal with no falloff and always missed.
Use entityAttackRange as their range, hit whenever inside it, and scale damage by
min(1, S/E, ((S/E)*(Ve/Vt))^(ln drf/ln drs)). DroneSE::CanAttack() limits bombers
to isCapitalSize ships, NPC capitals, stations and structures (engage error,
aggressive/guard/assist picks, ProcessEngage).
---
 src/eve-server/npc/Drone.cpp                  | 43 +++++++++++++++++++
 src/eve-server/npc/Drone.h                    |  7 +++
 src/eve-server/npc/DroneAI.cpp                |  7 ++-
 src/eve-server/npc/EntityService.cpp          |  2 +
 .../ship/modules/TurretFormulas.cpp           | 29 +++++++++++++
 5 files changed, 87 insertions(+), 1 deletion(-)

diff --git a/src/eve-server/npc/Drone.cpp b/src/eve-server/npc/Drone.cpp
index c43b3ef1..f54293c7 100644
--- a/src/eve-server/npc/Drone.cpp
+++ b/src/eve-server/npc/Drone.cpp
@@ -210,6 +210,22 @@ void DroneSE::UpdateStats(Client* pController) {
         s.orbitRange = base(AttrOrbitRange, 0.0);
     if (s.orbitRange <= 0.0)
         s.orbitRange = 500.0;
+    /* fighter bombers have no turret stats (no optimal, falloff or tracking).  they launch a missile that reaches
+     *  anything within entityAttackRange, so they always hit inside it and never outside it.  their damage scales
+     *  with the target's signature radius and speed like a missile's (see TurretFormulas::GetDroneToHit())
+     */
+    s.bomber = (m_self->groupID() == EVEDB::invGroups::Fighter_Bomber);
+    if (s.bomber) {
+        s.optimalRange = base(AttrEntityAttackRange, 20000.0);
+        s.falloff = 0.0;
+        s.tracking = 0.0;
+        s.effectRange = s.optimalRange;
+        s.aoeCloudSize = base(AttrAoeCloudSize, 0.0);
+        s.aoeVelocity = base(AttrAoeVelocity, 0.0);
+        double drf(base(AttrAoeDamageReductionFactor, 0.0)), drs(base(AttrAoeDamageReductionSensitivity, 0.0));
+        s.aoeExponent = (((drf > 1.0) and (drs > 1.0)) ? std::log(drf) / std::log(drs) : 1.0);
+    }
+
     if (s.orbitRange > s.effectRange)
         s.orbitRange = s.effectRange * 0.8;
     s.idleOrbitRange = s.orbitRange;
@@ -253,6 +269,33 @@ void DroneSE::UpdateStats(Client* pController) {
          s.falloff, s.effectRange, s.cycleTime, s.damageMultiplier, s.miningAmount, s.repairAmount);
 }
 
+bool DroneSE::CanAttack(SystemEntity* pTarget) const {
+    if (!m_stats.bomber)
+        return true;
+    if ((pTarget == nullptr) or (pTarget->GetSelf().get() == nullptr))
+        return false;
+    InventoryItemRef tRef(pTarget->GetSelf());
+    switch (tRef->categoryID()) {
+        case EVEDB::invCategories::Station:
+        case EVEDB::invCategories::Structure:
+        case EVEDB::invCategories::SovereigntyStructure:
+            return true;
+    }
+    // carriers, dreadnoughts, supercarriers, titans, freighters and the Rorqual
+    if (tRef->type().HasAttribute(AttrIsCapitalSize) and (tRef->type().GetAttribute(AttrIsCapitalSize).get_int() != 0))
+        return true;
+    // NPC capitals
+    switch (tRef->groupID()) {
+        case 865:   // Mission Amarr Empire Carrier
+        case 866:   // Mission Caldari State Carrier
+        case 867:   // Mission Gallente Federation Carrier
+        case 868:   // Mission Minmatar Republic Carrier
+        case 1052:  // Incursion Sansha's Nation Capital
+            return true;
+    }
+    return false;
+}
+
 /* ======================================================================================
  *  control
  * ====================================================================================== */
diff --git a/src/eve-server/npc/Drone.h b/src/eve-server/npc/Drone.h
index a45307a7..84586f1c 100644
--- a/src/eve-server/npc/Drone.h
+++ b/src/eve-server/npc/Drone.h
@@ -71,6 +71,11 @@ struct DroneStats {
     double miningAmount;        // m3 per cycle
     double repairAmount;        // shield or armor HP per cycle
     double bandwidth;
+    // fighter bombers launch missiles instead of firing turrets.  damage falls off with the target's signature and speed
+    bool bomber;
+    double aoeCloudSize;
+    double aoeVelocity;
+    double aoeExponent;         // ln(aoeDamageReductionFactor) / ln(aoeDamageReductionSensitivity)
 };
 
 class DroneSE
@@ -126,6 +131,8 @@ public:
 
     DroneAIMgr* GetAI()                                 { return m_AI; }
     const DroneStats& Stats() const                     { return m_stats; }
+    // fighter bombers only attack capital ships, stations and structures; everything else can attack anything
+    bool CanAttack(SystemEntity* pTarget) const;
 
     uint8 GetState()                                    { return m_AI->GetState(); }
     uint32 GetTargetID()                                { return m_AI->GetTargetID(); }
diff --git a/src/eve-server/npc/DroneAI.cpp b/src/eve-server/npc/DroneAI.cpp
index c18143bc..dab1dca7 100644
--- a/src/eve-server/npc/DroneAI.cpp
+++ b/src/eve-server/npc/DroneAI.cpp
@@ -285,6 +285,8 @@ void DroneAIMgr::ProcessReturn(ShipSE* pController, bool toBay) {
 void DroneAIMgr::ProcessEngage(ShipSE* pController) {
     SystemEntity* pTarget(m_pDrone->SystemMgr()->GetSE(m_targetID));
     bool usable((pTarget != nullptr) and !pTarget->IsDead() and (pTarget->SysBubble() == m_pDrone->SysBubble()));
+    if (usable and !m_pDrone->CanAttack(pTarget))
+        usable = false;
     if (usable and (pTarget->DestinyMgr() != nullptr))
         if (pTarget->DestinyMgr()->IsCloaked() or pTarget->DestinyMgr()->IsWarping())
             usable = false;
@@ -410,8 +412,9 @@ void DroneAIMgr::ProcessGuard(ShipSE* pController) {
             for (auto cur : m_pDrone->SystemMgr()->GetDrones())
                 if ((cur.second->GetControllerOwnerID() == m_activityCharID) and (cur.second->GetAI()->GetOrder() == DroneAI::Order::Engage)) {
                     pTarget = m_pDrone->SystemMgr()->GetSE(cur.second->GetAI()->GetTargetID());
-                    if (pTarget != nullptr)
+                    if ((pTarget != nullptr) and m_pDrone->CanAttack(pTarget))
                         break;
+                    pTarget = nullptr;
                 }
         } else {
             pTarget = PickAggressor();
@@ -445,6 +448,8 @@ SystemEntity* DroneAIMgr::PickAggressor() {
     auto usable = [&](SystemEntity* pSE) -> bool {
         if ((pSE == nullptr) or pSE->IsDead() or (pSE->SysBubble() != m_pDrone->SysBubble()))
             return false;
+        if (!m_pDrone->CanAttack(pSE))
+            return false;
         if ((pSE->DestinyMgr() != nullptr) and (pSE->DestinyMgr()->IsCloaked() or pSE->DestinyMgr()->IsWarping()))
             return false;
         return (Gap(pController, pSE) <= m_pDrone->ControlRange());
diff --git a/src/eve-server/npc/EntityService.cpp b/src/eve-server/npc/EntityService.cpp
index fa7e96ce..2abb1f0a 100644
--- a/src/eve-server/npc/EntityService.cpp
+++ b/src/eve-server/npc/EntityService.cpp
@@ -252,6 +252,8 @@ PyResult EntityBound::CmdEngage(PyCallArgs &call, PyList* droneIDs, PyInt* targe
             //{'FullPath': u'UI/Messages', 'label': u'EntityUnknownCommandBody'}(u'{targetTypeName} does not recognize the command you are trying to give it.')
             if ((action == DroneAI::Action::None) or (action == DroneAI::Action::Mine)) {
                 err = DroneError("EntityUnknownCommand", pDrone);
+            } else if (!pDrone->CanAttack(pTarget)) {
+                err = MakeError("CustomError", {{"error", new PyString(std::string(pDrone->GetName()) + " can only attack capital ships, stations and structures.")}});
             } else if (pShip->TargetMgr()->GetTarget(pTarget->GetID(), true) == nullptr) {
                 //{'FullPath': u'UI/Messages', 'label': u'EntityTargetMustBeTargetedBody'}(u'{targetTypeName} requires the target be locked onto by you, which it is not.')
                 err = DroneError("EntityTargetMustBeTargeted", pDrone);
diff --git a/src/eve-server/ship/modules/TurretFormulas.cpp b/src/eve-server/ship/modules/TurretFormulas.cpp
index 2d095586..0690e25f 100644
--- a/src/eve-server/ship/modules/TurretFormulas.cpp
+++ b/src/eve-server/ship/modules/TurretFormulas.cpp
@@ -167,6 +167,35 @@ float TurretFormulas::GetDroneToHit(DroneSE* pDrone, SystemEntity* pTarget)
         trackingTerm = (angular / stats.tracking) * (stats.sigResolution / targetSig);
     }
 
+    /* fighter bombers: their missile always hits a target within range, never one outside it.  the damage is scaled
+     *  like a missile's:  min(1, S/E, ((S/E) * (Ve/Vt)) ^ (ln(drf) / ln(drs)))
+     *  S = target signature, E = explosion radius, Ve = explosion velocity, Vt = target speed
+     */
+    if (stats.bomber) {
+        if (range > stats.optimalRange) {
+            _log(DAMAGE__TRACE, "Drone::GetToHit - bomber out of range: %.0f > %.0f", range, stats.optimalRange);
+            return 0;
+        }
+        double sig(25.0);
+        if (pTarget->GetSelf()->HasAttribute(AttrSignatureRadius))
+            sig = pTarget->GetSelf()->GetAttribute(AttrSignatureRadius).get_double();
+        if (sig <= 0.0)
+            sig = 25.0;
+        double factor(1.0);
+        if (stats.aoeCloudSize > 0.0) {
+            double sigTerm(sig / stats.aoeCloudSize);
+            factor = std::min(factor, sigTerm);
+            double speed(pTarget->GetVelocity().length());
+            if ((speed > 0.0) and (stats.aoeVelocity > 0.0))
+                factor = std::min(factor, std::pow(sigTerm * stats.aoeVelocity / speed, stats.aoeExponent));
+        }
+        if (factor < 0.01)
+            factor = 0.01;      // a hit always does something
+        _log(DAMAGE__TRACE, "Drone::GetToHit - bomber hit at %.0f m: sig %.0f, explosion %.0f, speed %.0f, damage x%.3f",
+             range, sig, stats.aoeCloudSize, pTarget->GetVelocity().length(), factor);
+        return static_cast<float>(factor);
+    }
+
     double rangeTerm(0.0);
     double outside(range - stats.optimalRange);
     if (outside > 0.0) {
