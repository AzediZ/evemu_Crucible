 src/eve-server/market/MarketDB.cpp                   | 12 +++++++++++-
 src/eve-server/market/MarketDB.h                     |  2 ++
 src/eve-server/market/MarketMgr.cpp                  |  3 +++
 4 files changed, 25 insertions(+), 1 deletion(-)
