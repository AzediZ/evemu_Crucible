+-- Wormholes:  the statics and phenomenon of each w-space system, and the wormholes that are open.
+--  utils/wormholes/gen_wormhole_sql.py writes this
+--  - mapWormholeSystems:  the 2,498 w-space systems.  statics as they were in Crucible:  one per system, two in
+--    class 2 (k-space and w-space).  class 4 systems had one static until Hyperion (2014) added the second.
+--    effectBeaconTypeID is the system effect beacon of its phenomenon (black hole, magnetar and so on), 0 for none
+--  - sysWormholes:  one row per open wormhole (WormholeMgr).  both ends share its mass and lifetime.  the K162
+--    (the far end) is made when the first ship warps to the wormhole
+-- +migrate Up
+DROP TABLE IF EXISTS mapWormholeSystems;
+CREATE TABLE mapWormholeSystems (
+  solarSystemID INT UNSIGNED NOT NULL,
+  wormholeClassID TINYINT UNSIGNED NOT NULL,
+  static1 INT UNSIGNED NOT NULL DEFAULT 0 COMMENT 'wormhole typeID always open here',
+  static2 INT UNSIGNED NOT NULL DEFAULT 0,
+  effectBeaconTypeID INT UNSIGNED NOT NULL DEFAULT 0 COMMENT 'system effect beacon (group 920), 0 = none',
+  PRIMARY KEY (solarSystemID)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
