+void WormholeMgr::Jump(Client* pClient, uint32 itemID)
+{
+    if (!m_initalized)
+        throw CustomError("Wormholes are switched off on this server.");
+    std::map<uint32, uint32>::iterator bItr = m_byItem.find(itemID);
+    if (bItr == m_byItem.end())
