+std::string Killboard::OwnerLink(uint32 ownerID)
+{
+    if (ownerID == 0)
+        return std::string();
+    return Fmt("<a href=\"/kb/%s/%u\">", OwnerPath(ownerID), ownerID) + Esc(m_data.OwnerName(ownerID)) + "</a>";
