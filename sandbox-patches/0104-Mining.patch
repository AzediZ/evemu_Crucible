From 5c9b141fe6e488568e145e5e8d90f0e46944c379 Mon Sep 17 00:00:00 2001
From: AzediZ <145237384+AzediZ@users.noreply.github.com>
Date: Fri, 16 Oct 2026 01:13:47 +0000
Subject: [PATCH 104/110] Mining

Three mining laser crashes fixed:
- a cycle that fills the hold put the ore in after stopping the module,
  which had cleared its target:  the ore now goes in first
- two lasers emptying the same rock:  the one whose share came to less
  than one unit kept the deleted rock as its target;  every laser on
  the rock stops now
- a laser emptying its rock ran one last partial cycle on the rock it
  had already emptied and deleted it twice (memory corruption, then a
  crash somewhere unrelated)

Ambient miners are Civilian Hulk NPCs by default (<ambient><MinerModel>
entity) instead of pilotless mining barges that looked like empty
player ships;  hull brings the barges back.
---
 src/eve-server/EVEServerConfig.cpp          |  2 +-
 src/eve-server/EVEServerConfig.h            |  2 +-
 src/eve-server/ship/modules/MiningLaser.cpp | 87 +++++++++++++++------
 src/eve-server/ship/modules/MiningLaser.h   |  3 +
 utils/config/eve-server.xml                 |  2 +-
 5 files changed, 67 insertions(+), 29 deletions(-)

diff --git a/src/eve-server/EVEServerConfig.cpp b/src/eve-server/EVEServerConfig.cpp
index d0a559e..c6d20db 100644
--- a/src/eve-server/EVEServerConfig.cpp
+++ b/src/eve-server/EVEServerConfig.cpp
@@ -567,7 +567,7 @@ EVEServerConfig::EVEServerConfig()
     ambient.MinerCyclesMin = 4;
     ambient.MinerCyclesMax = 10;
     ambient.MinerRockSwitchChance = 0.3f;
-    ambient.MinerModel = "hull";
+    ambient.MinerModel = "entity";
     ambient.MinerHaulerVisits = true;
     ambient.MinerHaulerInterval = 600;
     ambient.IceMinerFactor = 0.5f;
diff --git a/src/eve-server/EVEServerConfig.h b/src/eve-server/EVEServerConfig.h
index 4a0bb0c..6d5a3a2 100644
--- a/src/eve-server/EVEServerConfig.h
+++ b/src/eve-server/EVEServerConfig.h
@@ -674,7 +674,7 @@ public:
         uint8 MinerCyclesMin;               // laser cycles until a miner is full
         uint8 MinerCyclesMax;               // laser cycles
         float MinerRockSwitchChance;        // chance after each cycle (from the 2nd) to move to another rock
-        std::string MinerModel;             // hull = mining barges with strip miner beams.  entity = Civilian Hulk entities without beams
+        std::string MinerModel;             // entity = Civilian Hulk entities without beams (default).  hull = mining barges with strip miner beams, which look like pilotless player ships
         bool MinerHaulerVisits;             // a hauler visits belts with 2 or more miners
         uint16 MinerHaulerInterval;         // seconds, mean time between hauler visits per belt
