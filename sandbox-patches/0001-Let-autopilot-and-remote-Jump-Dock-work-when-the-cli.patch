diff --git a/src/eve-server/system/DestinyManager.cpp b/src/eve-server/system/DestinyManager.cpp
index 025ec26a..f8cc3075 100644
--- a/src/eve-server/system/DestinyManager.cpp
+++ b/src/eve-server/system/DestinyManager.cpp
@@ -1808,6 +1808,27 @@ void DestinyManager::WarpStop(double currentShipSpeed) {
     Halt();
 }
 
+bool DestinyManager::FinishWarpNear(const GPoint& point, double range) {
+    if (m_warpState == nullptr)
+        return true;
+    // only a warp that is already slowing down, and that ends at the place being asked about
+    if (!m_warpState->decel)
+        return false;
+    if (m_targetPoint.distance(point) > range)
+        return false;
+    if (m_targBubble == nullptr)
+        m_targBubble = sBubbleMgr.GetBubble(mySE->SystemMgr(), m_targetPoint);
+
+    _log(AUTOPILOT__MESSAGE, "Destiny::FinishWarpNear(): %s(%u) - client landed first; finishing warp with %.2f m left.", \
+            mySE->GetName(), mySE->GetID(), m_targetDistance);
+
+    // put the ship on its landing point (this also moves it into the target bubble), then end the warp normally
+    m_targetDistance = 0;
+    WarpUpdate(m_speedToLeaveWarp);
+    WarpStop(m_speedToLeaveWarp);
+    return true;
+}
