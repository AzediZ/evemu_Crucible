+        return (((a == factionCaldari) and (b == factionGallente)) or ((a == factionGallente) and (b == factionCaldari))
+             or ((a == factionAmarr) and (b == factionMinmatar)) or ((a == factionMinmatar) and (b == factionAmarr)));
+    }
+}
