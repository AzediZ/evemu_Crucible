From c04a05cced93ce590fee38236a5ee0f89fbce172 Mon Sep 17 00:00:00 2001
From: AzediZ <145237384+AzediZ@users.noreply.github.com>
Date: Thu, 15 Oct 2026 21:28:15 +0000
Subject: [PATCH 92/98] Killmails open, copy and drag again

The client looks up every ID it gets with a killmail: the moon, the
victim's and final blow's alliance and faction, and each attacker's corp,
ship and weapon. Zeros came back as 0, which isn't an owner, location or
type, so double-clicking a kill, "Copy kill information" and dragging it
into chat all failed. The kill lists now send None for missing IDs and
attacker tags leave out a missing corp, ship or weapon. Kills already in
the database are cleaned up as they're read.
---
 src/eve-server/character/CharacterDB.cpp     | 24 +++++++++++---------
 src/eve-server/corporation/CorporationDB.cpp | 24 +++++++++++---------
 src/eve-server/system/Damage.cpp             | 10 ++++++--
 3 files changed, 34 insertions(+), 24 deletions(-)

diff --git a/src/eve-server/character/CharacterDB.cpp b/src/eve-server/character/CharacterDB.cpp
index fbbd55f3..5add4c2c 100644
--- a/src/eve-server/character/CharacterDB.cpp
+++ b/src/eve-server/character/CharacterDB.cpp
@@ -2033,23 +2033,25 @@ PyRep* CharacterDB::GetKillOrLoss(uint32 charID) {
         "SELECT"
         "  killID,"
         "  solarSystemID,"
-        "  victimCharacterID,"
+        // the client looks up every one of these it gets (kill list, Copy kill information):  missing ones are None, not 0
+        "  NULLIF(victimCharacterID, 0) AS victimCharacterID,"
         "  victimCorporationID,"
-        "  victimAllianceID,"
-        "  victimFactionID,"
+        "  NULLIF(victimAllianceID, 0) AS victimAllianceID,"
+        "  NULLIF(victimFactionID, 0) AS victimFactionID,"
         "  victimShipTypeID,"
-        "  NULLIF(finalCharacterID, 0) AS finalCharacterID,"   // npcs and structures have no character:  None, not 0
-        "  finalCorporationID,"
-        "  finalAllianceID,"
-        "  finalFactionID,"
-        "  finalShipTypeID,"
-        "  finalWeaponTypeID,"
-        "  killBlob,"
+        "  NULLIF(finalCharacterID, 0) AS finalCharacterID,"   // npcs and structures have no character
+        "  NULLIF(finalCorporationID, 0) AS finalCorporationID,"
+        "  NULLIF(finalAllianceID, 0) AS finalAllianceID,"
+        "  NULLIF(finalFactionID, 0) AS finalFactionID,"
+        "  NULLIF(finalShipTypeID, 0) AS finalShipTypeID,"
+        "  NULLIF(finalWeaponTypeID, 0) AS finalWeaponTypeID,"
+        // kills saved before 15 Oct 2026 can have r=0, s=0 or w=0 in an attacker's tag
+        "  REPLACE(REPLACE(REPLACE(killBlob, ' r=0 ', ' '), ' s=0 ', ' '), ' w=0 ', ' ') AS killBlob,"
         "  killTime,"
         "  victimDamageTaken,"
         "  finalSecurityStatus,"
         "  finalDamageDone,"
-        "  moonID"
+        "  NULLIF(moonID, 0) AS moonID"
         " FROM chrKillTable"
         " WHERE ((victimCharacterID = %u) OR (finalCharacterID = %u))", charID, charID))
         /* should we limit this? */
diff --git a/src/eve-server/corporation/CorporationDB.cpp b/src/eve-server/corporation/CorporationDB.cpp
index 636c27bf..11d426f2 100644
--- a/src/eve-server/corporation/CorporationDB.cpp
+++ b/src/eve-server/corporation/CorporationDB.cpp
@@ -2694,23 +2694,25 @@ PyRep* CorporationDB::GetKillsAndLosses(uint32 corpID, uint32 number, uint32 off
         "SELECT"
         "  killID,"
         "  solarSystemID,"
-        "  victimCharacterID,"
+        // the client looks up every one of these it gets (kill list, Copy kill information):  missing ones are None, not 0
+        "  NULLIF(victimCharacterID, 0) AS victimCharacterID,"
         "  victimCorporationID,"
-        "  victimAllianceID,"
-        "  victimFactionID,"
+        "  NULLIF(victimAllianceID, 0) AS victimAllianceID,"
+        "  NULLIF(victimFactionID, 0) AS victimFactionID,"
         "  victimShipTypeID,"
-        "  NULLIF(finalCharacterID, 0) AS finalCharacterID,"   // npcs and structures have no character:  None, not 0
-        "  finalCorporationID,"
-        "  finalAllianceID,"
-        "  finalFactionID,"
-        "  finalShipTypeID,"
-        "  finalWeaponTypeID,"
-        "  killBlob,"
+        "  NULLIF(finalCharacterID, 0) AS finalCharacterID,"   // npcs and structures have no character
+        "  NULLIF(finalCorporationID, 0) AS finalCorporationID,"
+        "  NULLIF(finalAllianceID, 0) AS finalAllianceID,"
+        "  NULLIF(finalFactionID, 0) AS finalFactionID,"
+        "  NULLIF(finalShipTypeID, 0) AS finalShipTypeID,"
+        "  NULLIF(finalWeaponTypeID, 0) AS finalWeaponTypeID,"
+        // kills saved before 15 Oct 2026 can have r=0, s=0 or w=0 in an attacker's tag
+        "  REPLACE(REPLACE(REPLACE(killBlob, ' r=0 ', ' '), ' s=0 ', ' '), ' w=0 ', ' ') AS killBlob,"
         "  killTime,"
         "  victimDamageTaken,"
         "  finalSecurityStatus,"
         "  finalDamageDone,"
-        "  moonID"
+        "  NULLIF(moonID, 0) AS moonID"
         " FROM chrKillTable"
         " WHERE victimCorporationID = %u OR finalCorporationID = %u", corpID, corpID))
     {
diff --git a/src/eve-server/system/Damage.cpp b/src/eve-server/system/Damage.cpp
index 4cba2e4a..6e008e83 100644
--- a/src/eve-server/system/Damage.cpp
+++ b/src/eve-server/system/Damage.cpp
@@ -203,16 +203,22 @@ static std::string KillAttackerTag(uint32 charID, uint32 corpID, uint32 allyID,
                                    uint16 weaponTypeID, float damage, double security)
 {
     std::stringstream tag;
+    // anything we don't know is left out:  the client looks up every value it gets, and has no owner or type 0
     tag << "<a";
     if (charID != 0)
         tag << " c=" << charID;
-    tag << " r=" << corpID;
+    if (corpID != 0)
+        tag << " r=" << corpID;
     // an npc's line shows only its type, owner and damage
     if ((charID != 0) and (allyID != 0))
         tag << " a=" << allyID;
     if ((charID != 0) and (factionID != 0))
         tag << " f=" << factionID;
-    tag << " s=" << shipTypeID << " w=" << weaponTypeID << " d=" << (uint32)damage;
+    if (shipTypeID != 0)
+        tag << " s=" << shipTypeID;
+    if (weaponTypeID != 0)
+        tag << " w=" << weaponTypeID;
+    tag << " d=" << (uint32)damage;
     if (charID != 0) {
         char sec[16];
         snprintf(sec, sizeof(sec), "%.1f", security);
-- 
2.34.1

