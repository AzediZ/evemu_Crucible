+    if (!CanStartJump(call.client))
+        return PyStatic.NewNone();
+
+    JumpDrive::Beacon beacon;
+    if (JumpDrive::FindAllianceBeacon(call.client, beaconID->value(), beacon))
+        OpenJumpPortal(call.client, beacon);
+
+    return PyStatic.NewNone();
+}
