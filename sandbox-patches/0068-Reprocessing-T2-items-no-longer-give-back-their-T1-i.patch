From d16fcf0f8037b65db9bda3803b68562322235637 Mon Sep 17 00:00:00 2001
From: AzediZ <145237384+AzediZ@users.noreply.github.com>
Date: Thu, 15 Oct 2026 13:13:24 +0000
Subject: [PATCH 68/91] Reprocessing: T2 items no longer give back their T1
 item, Scrapmetal Processing 5% a level

A T2 item's invTypeMaterials already hold its T1 item's minerals, so the T1 item (the requirement marked recycle) is left out of what it returns.  Scrapmetal Processing was 4% a level; Crucible's is 5%.
---
 src/eve-server/station/ReprocessingDB.cpp      | 4 +++-
 src/eve-server/station/ReprocessingService.cpp | 4 ++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/eve-server/station/ReprocessingDB.cpp b/src/eve-server/station/ReprocessingDB.cpp
index 7b5480c89..bfe7af0bd 100755
--- a/src/eve-server/station/ReprocessingDB.cpp
+++ b/src/eve-server/station/ReprocessingDB.cpp
@@ -30,10 +30,12 @@
 bool ReprocessingDB::GetRecoverables(const uint32 typeID, std::vector<Recoverable> &into) {
     DBQueryResult res;
 
+    /* the components a blueprint uses up.  not a requirement marked recycle (extra, the T1 item of a T2 one):  its
+     *  materials are already in the product's invTypeMaterials, below */
     if (!sDatabase.RunQuery(res,
                 "SELECT requiredTypeID, MIN(quantity) FROM ramTypeRequirements"
                 " LEFT JOIN invBlueprintTypes ON typeID = blueprintTypeID"
-                " WHERE damagePerJob = 1 AND ("
+                " WHERE damagePerJob = 1 AND extra = 0 AND ("
                 "   (activityID = 6 AND typeID = %u)"
                 "   OR"
                 "    (activityID = 1 AND productTypeID = %u))"
diff --git a/src/eve-server/station/ReprocessingService.cpp b/src/eve-server/station/ReprocessingService.cpp
index 1f0f81af6..838df80ae 100755
--- a/src/eve-server/station/ReprocessingService.cpp
+++ b/src/eve-server/station/ReprocessingService.cpp
@@ -291,7 +291,7 @@ float ReprocessingServiceBound::CalcReprocessingEfficiency(const Client* pClient
         reprocessingEfficiency = 0.375
         *(1 + 0.02 * RefiningSkill)
         *(1 + 0.04 * RefineryEfficiencySkill)
-        *(1 + 0.05 * OreProcessingSkill)
+        *(1 + 0.05 * OreProcessingSkill)     (modules, ships and the rest:  Scrapmetal Processing, also 5% a level)
     */
     CharacterRef cRef = pClient->GetChar();
     double efficiency =  (0.375f
@@ -303,7 +303,7 @@ float ReprocessingServiceBound::CalcReprocessingEfficiency(const Client* pClient
         if (specificSkill) {
             efficiency *= (1 + 0.05f * cRef->GetSkillLevel(specificSkill));
         } else {
-            efficiency *= (1 + 0.04f * cRef->GetSkillLevel(EvESkill::ScrapmetalProcessing));    // use Scrapmetal Processing as default
+            efficiency *= (1 + 0.05f * cRef->GetSkillLevel(EvESkill::ScrapmetalProcessing));    // use Scrapmetal Processing as default
         }
     }
 
-- 
2.34.1

