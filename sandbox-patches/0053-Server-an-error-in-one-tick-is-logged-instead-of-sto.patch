From 4b60fb0d05e0745acba03612903f35d50b4f4264 Mon Sep 17 00:00:00 2001
From: AzediZ <145237384+AzediZ@users.noreply.github.com>
Date: Wed, 14 Oct 2026 19:38:58 +0000
Subject: [PATCH 53/63] Server: an error in one tick is logged instead of
 stopping the server

Nothing caught an exception that escaped a system's, client's or manager's tick, so one bad case
anywhere (a Python tuple written past its end, a missing map entry) stopped the whole server.

- EntityList::Process runs each system, client, target manager, probe and manager tick on its own,
  catches what escapes, logs it with where it happened and carries on. The log is limited (the first
  20, then every 100th), so an error that repeats every second can't flood it. A system whose tick
  throws stays loaded.
- The main loop catches anything else as a last resort.
- Client::ProcessNet drops a packet whose handler throws a C++ exception and handles the rest.
  Its "failed to dispatch" log line no longer reads the character before character select (null),
  or the type name table past its end for a bad packet type.

A real crash (segfault) still stops the server and writes a crash report.
---
 src/eve-server/Client.cpp     | 10 +++-
 src/eve-server/EntityList.cpp | 98 ++++++++++++++++++++++++-----------
 src/eve-server/eve-server.cpp | 26 +++++++---
 3 files changed, 96 insertions(+), 38 deletions(-)

diff --git a/src/eve-server/Client.cpp b/src/eve-server/Client.cpp
index 4e6352d..3c9e5d5 100644
--- a/src/eve-server/Client.cpp
+++ b/src/eve-server/Client.cpp
@@ -224,12 +224,20 @@ bool Client::ProcessNet()
     PyPacket *p(nullptr);
     while ((p = PopPacket())) {
         try {
+            // before character select there's no character, and a bad packet can carry any type number
             if (!DispatchPacket(p))
-                sLog.Error("Client", "%s: Failed to dispatch packet of type %s (%i).", m_char->name(), MACHONETMSG_TYPE_NAMES[ p->type ], (int)p->type);
+                sLog.Error("Client", "%s: Failed to dispatch packet of type %s (%i).",
+                           (m_char.get() != nullptr ? m_char->name() : GetAddress().c_str()),
+                           (((int)p->type >= 0) and ((int)p->type < MACHONETMSG_TYPE_COUNT) ? MACHONETMSG_TYPE_NAMES[ p->type ] : "unknown"), (int)p->type);
         }
         catch(PyException& e) {
             _SendException(p->dest, p->source.callID, p->type, WRAPPEDEXCEPTION, &e.ssException);
         }
+        catch(std::exception& e) {
+            // one bad call no longer stops the server;  the packet is dropped and the rest are handled
+            sLog.Error("Client", "%s: Caught %s while handling a packet of type %i.  Dropped it.",
+                       (m_char.get() != nullptr ? m_char->name() : GetAddress().c_str()), e.what(), (int)p->type);
+        }
 
         // every packet is freed once it's handled.  this set p to null first, so only the last one ever was
         //  (upstream fixed the same leak in d74a231)
