 if (-not (Ensure-Engine)) { exit 1 }
-Say 'Rebuilding the server from the code in this folder. This can take 10 to 20 minutes...'
+Say 'Rebuilding the server from the code in this folder. The first rebuild takes 10 to 20 minutes; later ones usually a few minutes...'
 $c = Dock compose up -d --build
-Clean-Docker
