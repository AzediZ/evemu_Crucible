 $btnRebuild.Add_Click({
     Invoke-Click {
         if (-not (Confirm-Space)) { return }
-        if (Ask-YesNo 'Rebuild the server from the code in this folder? It takes 10 to 20 minutes, and the server is restarted at the end. Your universe is kept, and old server images and leftover build files are removed afterwards.') {
