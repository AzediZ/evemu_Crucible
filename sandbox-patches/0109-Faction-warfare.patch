+/**
+ * @name ControlBunker.h
+ *   a factional warfare system's control bunker in space (FacWarMgr.h)
+ *
+ * @date:          22 October 2026
+ */
+
+#ifndef EVEMU_FACTION_CONTROLBUNKER_H_
+#define EVEMU_FACTION_CONTROLBUNKER_H_
+
+#include "system/SystemEntity.h"
+
+/* a war zone system's control bunker.  it can be shot only while its system is vulnerable (FacWarMgr::BunkerVulnerable());
+ *  what's left of it is FacWarMgr's (the system's row), so a bunker put up again is the same bunker.  destroyed, the system goes to its attacker at the next downtime */
+class ControlBunkerSE
+: public ObjectSystemEntity
+{
+public:
+    ControlBunkerSE(InventoryItemRef self, EVEServiceManager& services, SystemManager* system, const FactionData& data);
+    virtual ~ControlBunkerSE()                          { }
+
+    /* class type pointer querys. */
+    virtual ControlBunkerSE*    GetControlBunkerSE()    { return this; }
+    /* class type tests. */
+    virtual bool                IsControlBunkerSE()     { return true; }
+
+    /* SystemEntity interface */
+    virtual bool                IsInvul();
+    virtual void                Killed(Damage& damage);
+
+    // a hit we took (Damage.cpp):  FacWarMgr keeps what's left
+    void                        OnDamaged(SystemEntity* pAttacker);
+    // shield, armor and structure left (1 = whole)
+    void                        SetHealth(double shield, double armor, double hull);
+};
+
+#endif  // EVEMU_FACTION_CONTROLBUNKER_H_
diff --git a/src/eve-server/faction/FacWarMgr.cpp b/src/eve-server/faction/FacWarMgr.cpp
new file mode 100644
index 0000000..ce075cc
--- /dev/null
+++ b/src/eve-server/faction/FacWarMgr.cpp
@@ -0,0 +1,577 @@
+/**
+ * @name FacWarMgr.cpp
+ *   factional warfare's militias.  see FacWarMgr.h
+ *
+ * @date:          22 October 2026
+ */
+
+#include "eve-server.h"
+
+#include "EVE_Corp.h"
+
+#include "Client.h"
+#include "EntityList.h"
+#include "EVEServerConfig.h"
+#include "StaticDataMgr.h"
+#include "character/Character.h"
+#include "character/CharacterDB.h"
+#include "corporation/CorpMgr.h"
+#include "corporation/CorporationDB.h"
+#include "faction/FacWarMgr.h"
+#include "mail/MailMgr.h"
+#include "standing/StandingDB.h"
+
+/*
+ * FACWAR__ERROR
+ * FACWAR__WARNING
+ * FACWAR__INFO
+ */
+
+namespace {
+    // facwarMinStandingsToJoin
+    const float MinStanding = 0.5f;
+    // a character enlists once in a day at most
+    const int64 RejoinWait = EvE::Time::Day;
+    // the writes' errors (logged by the database layer)
+    DBerror s_err;
+
+    std::string FactionName(uint32 factionID)                   { return sDataMgr.GetOwnerName(factionID); }
+
+    // a mail to a player
+    void Tell(uint32 charID, const std::string& title, const std::string& body)
+    {
+        if (!IsCharacterID(charID))
+            return;
+        MailMgr::SendMail(charID, charID, title, body);
+    }
+
+    void AddChange(PyDict* change, const char* key, PyRep* oldValue, PyRep* newValue)
+    {
+        PyTuple* tuple = new PyTuple(2);
+            tuple->SetItem(0, oldValue);
+            tuple->SetItem(1, newValue);
+        change->SetItemString(key, tuple);
+    }
+
+    PyRep* NullableInt(uint32 value)                            { return ((value == 0) ? PyStatic.NewNone() : new PyInt(value)); }
+
+    void SaveEnlistment(uint32 ownerID, uint32 factionID, uint8 status, int64 startDate, int64 effectiveAt)
+    {
+        DBerror err;
+        if (!sDatabase.RunQuery(err, "REPLACE INTO facWarEnlistments (ownerID, factionID, status, startDate, effectiveAt, warnedAt)"
+                                     " VALUES (%u, %u, %u, %lli, %lli, 0)", ownerID, factionID, status, startDate, effectiveAt))
+            _log(DATABASE__ERROR, "FacWarMgr:  enlistment of %u not saved:  %s", ownerID, err.c_str());
+    }
+}
+
+FacWarMgr::FacWarMgr()
+: m_nextComplexID(1),
+m_seeded(false),
+m_taken(0),
+m_killsPaid(0),
+m_killPoints(0),
+m_lastSave(0),
+m_lastCheckDay(0)
+{
+}
+
+int FacWarMgr::Initialize()
+{
+    DBQueryResult res;
+    DBResultRow row;
+    if (sDatabase.RunQuery(res, "SELECT corporationID, warFactionID FROM crpCorporation WHERE warFactionID IS NOT NULL AND warFactionID <> 0"))
+        while (res.GetRow(row))
+            m_corpFaction[row.GetUInt(0)] = row.GetUInt(1);
+    // the militia corporations are their faction's, whatever the database says
+    for (uint32 factionID : {(uint32)factionCaldari, (uint32)factionMinmatar, (uint32)factionAmarr, (uint32)factionGallente})
+        m_corpFaction[MilitiaCorpOf(factionID)] = factionID;
+    // the corporations' joins and leaves waiting for downtime
+    if (sDatabase.RunQuery(res, "SELECT ownerID, factionID, status, startDate, effectiveAt FROM facWarEnlistments WHERE status <> %u", FacWar::CorpStatus::Active))
+        while (res.GetRow(row)) {
+            if (!IsPlayerCorp(row.GetUInt(0)))
+                continue;
+            Request r;
+            r.factionID = row.GetUInt(1);
+            r.status = (uint8)row.GetUInt(2);
+            r.askedAt = row.GetInt64(3);
+            r.effectiveAt = row.GetInt64(4);
+            m_requests[row.GetUInt(0)] = r;
+        }
+    // the war zones, their complexes and who holds what (FacWarSystems.cpp)
+    LoadSystems();
+    uint32 contested(0);
+    for (auto& cur : m_systems)
+        if (cur.second.points > 0)
+            ++contested;
+    sLog.Blue("        FacWarMgr", "Militias Initialized:  %u corporations in militias, %u joins or leaves waiting for downtime, %u war zone systems (%u contested).",
+              (uint32)m_corpFaction.size(), (uint32)m_requests.size(), (uint32)m_zone.size(), contested);
+    return 1;
+}
+
+void FacWarMgr::Process()
+{
+    int64 now(GetFileTimeNow());
+    // the corporations' joins and leaves at downtime
+    std::vector<uint32> due;
+    for (auto& cur : m_requests)
+        if (cur.second.effectiveAt <= now)
+            due.push_back(cur.first);
+    for (uint32 corpID : due) {
+        Request r(m_requests[corpID]);
+        m_requests.erase(corpID);
+        if (r.status == FacWar::CorpStatus::Joining) {
+            // it might have joined an alliance since, or closed
+            CorpData data = CorpData();
+                data.corporationID = corpID;
+            CorporationDB::GetCorpData(data);
+            uint32 ceoID(CorporationDB::GetCorporationCEO(corpID));
+            if ((data.allianceID != 0) or (ceoID == 0)) {
+                sDatabase.RunQuery(s_err, "DELETE FROM facWarEnlistments WHERE ownerID = %u", corpID);
+                _log(FACWAR__INFO, "FacWarMgr:  corp %u's enlistment in the %s militia lapsed", corpID, FactionName(r.factionID).c_str());
+                continue;
+            }
+            SaveEnlistment(corpID, r.factionID, FacWar::CorpStatus::Active, now, 0);
+            SetCorpMilitia(corpID, r.factionID);
+            Tell(ceoID, "Enlisted in the " + FactionName(r.factionID) + " militia", "Your corporation is now a member of the "
+                 + FactionName(r.factionID) + " militia.  Its members may fight the militias it is at war with anywhere, without CONCORD.");
+        } else {
+            sDatabase.RunQuery(s_err, "DELETE FROM facWarEnlistments WHERE ownerID = %u", corpID);
+            SetCorpMilitia(corpID, 0);
+            Tell(CorporationDB::GetCorporationCEO(corpID), "Left the " + FactionName(r.factionID) + " militia",
+                 "Your corporation is no longer a member of the " + FactionName(r.factionID) + " militia.");
+        }
+    }
+    // once a day at downtime (and once after a start past that hour):  the members' standings
+    int64 day(now / EvE::Time::Day);
+    int64 hour((now / EvE::Time::Hour) % 24);
+    if ((day != m_lastCheckDay) and (hour >= (int64)sConfig.alliance.ExecutorTallyHour)) {
+        m_lastCheckDay = day;
+        CheckStandings(now);
+    }
+
+    /* the war zones (FacWarSystems.cpp):  their first complexes, systems whose bunker fell before the last downtime change
+     *  hands, taken complexes are replaced, and what changed is saved */
+    if (!m_seeded) {
+        m_seeded = true;
+        for (auto& cur : m_systems)
+            for (uint8 i = 0; i < ComplexesPerSystem; ++i)
+                AddComplex(cur.first);
+        _log(FACWAR__INFO, "FacWarMgr:  %u complexes in %u war zone systems", (uint32)m_complexes.size(), (uint32)m_systems.size());
+    }
+    bool flip(false);
+    for (auto& cur : m_systems)
+        if ((cur.second.capturedBy != 0) and (NextDowntime(cur.second.capturedAt) <= now))
+            flip = true;
+    if (flip)
+        FlipConquered();
+    while (!m_newComplexes.empty() and (m_newComplexes.begin()->first <= now)) {
+        m_newComplexes.erase(m_newComplexes.begin());
+        // a random war zone system with fewer than three
+        std::vector<uint32> room;
+        std::unordered_map<uint32, uint8> count;
+        for (auto& cur : m_complexes)
+            ++count[cur.second.systemID];
+        for (auto& cur : m_systems)
+            if (count[cur.first] < 3)
+                room.push_back(cur.first);
+        if (!room.empty())
+            AddComplex(room[MakeRandomInt(0, (int)room.size() - 1)]);
+    }
+    if ((now - m_lastSave) >= EvE::Time::Minute) {
+        m_lastSave = now;
+        for (auto& cur : m_systems)
+            if (cur.second.dirty)
+                SaveSystem(cur.first);
+    }
+}
+
+/* ------------------------------------------------------------------------------------------------------------------
+ *  the militias
+ * ------------------------------------------------------------------------------------------------------------------ */
+bool FacWarMgr::IsWarFaction(uint32 factionID)
+{
+    return (MilitiaCorpOf(factionID) != 0);
+}
+
+uint32 FacWarMgr::MilitiaCorpOf(uint32 factionID)
+{
+    // facFactions.militiaCorporationID
+    switch (factionID) {
+        case factionAmarr:      return 1000179;     // 24th Imperial Crusade
+        case factionCaldari:    return 1000180;     // State Protectorate
+        case factionGallente:   return 1000181;     // Federal Defense Union
+        case factionMinmatar:   return 1000182;     // Tribal Liberation Force
+        default:                return 0;
+    }
+}
+
+uint32 FacWarMgr::FactionOfMilitiaCorp(uint32 corpID)
+{
+    switch (corpID) {
+        case 1000179:   return factionAmarr;
+        case 1000180:   return factionCaldari;
+        case 1000181:   return factionGallente;
+        case 1000182:   return factionMinmatar;
+        default:        return 0;
+    }
+}
+
+bool FacWarMgr::AreEnemies(uint32 factionA, uint32 factionB)
+{
+    auto side = [](uint32 factionID) -> int {
+        if ((factionID == factionAmarr) or (factionID == factionCaldari))
+            return 1;
+        if ((factionID == factionGallente) or (factionID == factionMinmatar))
+            return 2;
+        return 0;
+    };
+    int a(side(factionA)), b(side(factionB));
+    return ((a != 0) and (b != 0) and (a != b));
+}
+
+uint32 FacWarMgr::ZoneEnemyOf(uint32 factionID)
+{
+    switch (factionID) {
+        case factionAmarr:      return factionMinmatar;
+        case factionMinmatar:   return factionAmarr;
+        case factionCaldari:    return factionGallente;
+        case factionGallente:   return factionCaldari;
+        default:                return 0;
+    }
+}
+
+uint32 FacWarMgr::WarFactionOf(uint32 corpID) const
+{
+    std::unordered_map<uint32, uint32>::const_iterator itr = m_corpFaction.find(corpID);
+    return ((itr == m_corpFaction.end()) ? 0 : itr->second);
+}
+
+bool FacWarMgr::EnemyCorps(uint32 corpA, uint32 corpB) const
+{
+    if (corpA == corpB)
+        return false;
+    return AreEnemies(WarFactionOf(corpA), WarFactionOf(corpB));
+}
+
+bool FacWarMgr::SameMilitia(uint32 corpA, uint32 corpB) const
+{
+    uint32 a(WarFactionOf(corpA));
+    return ((a != 0) and (a == WarFactionOf(corpB)));
+}
+
+void FacWarMgr::CorpsOf(uint32 factionID, std::vector<uint32>& into) const
+{
+    uint32 militia(MilitiaCorpOf(factionID));
+    if (militia == 0)
+        return;
+    into.push_back(militia);
+    for (auto& cur : m_corpFaction)
+        if ((cur.second == factionID) and (cur.first != militia))
+            into.push_back(cur.first);
+}
+
+bool FacWarMgr::InWarZone(uint32 systemID, uint32 factionID) const
+{
+    std::unordered_map<uint32, uint32>::const_iterator itr = m_zone.find(systemID);
+    if ((itr == m_zone.end()) or (factionID == 0))
+        return false;
+    return ((itr->second == factionID) or (itr->second == ZoneEnemyOf(factionID)));
+}
+
+/* ------------------------------------------------------------------------------------------------------------------
+ *  enlisting
+ * ------------------------------------------------------------------------------------------------------------------ */
+float FacWarMgr::StandingOf(uint32 charID, uint32 factionID)
+{
+    return StandingDB::GetStanding(factionID, charID);
+}
+
+float FacWarMgr::CorpStandingOf(uint32 corpID, uint32 factionID)
+{
+    DBQueryResult res;
+    DBResultRow row;
+    if (!sDatabase.RunQuery(res, "SELECT AVG(s.standing) FROM repStandings AS s JOIN chrCharacters AS c ON c.characterID = s.toID"
+                                 " WHERE s.fromID = %u AND c.corporationID = %u AND s.standing <> 0", factionID, corpID)
+        or !res.GetRow(row) or row.IsNull(0))
+        return 0.0f;
+    return (float)row.GetDouble(0);
+}
+
+bool FacWarMgr::CanEnlist(uint32 charID, uint32 factionID, bool letter, std::string& err) const
+{
+    if (!IsWarFaction(factionID)) {
+        err = "That faction has no militia.";
+        return false;
+    }
+    uint32 corpID(CharacterDB::GetCorpID(charID));
+    if (WarFactionOf(corpID) != 0) {
+        err = "You are already in a militia.";
+        return false;
+    }
+    if (IsPlayerCorp(corpID)) {
+        err = "Your corporation's CEO or a director enlists the corporation.  You can enlist on your own only while you are in an NPC corporation.";
+        return false;
+    }
+    float standing(StandingOf(charID, factionID));
+    if (!letter and (standing < MinStanding)) {
+        char buf[200];
+        snprintf(buf, sizeof(buf), "The %s militia takes those whose standing to it is %.1f or more.  Yours is %.2f.", FactionName(factionID).c_str(),
+                 MinStanding, standing);
+        err = buf;
+        return false;
+    }
+    DBQueryResult res;
+    DBResultRow row;
+    if (sDatabase.RunQuery(res, "SELECT startDate FROM facWarEnlistments WHERE ownerID = %u", charID) and res.GetRow(row)
+        and ((GetFileTimeNow() - row.GetInt64(0)) < RejoinWait)) {
+        err = "You enlisted in a militia less than 24 hours ago.";
+        return false;
+    }
+    return true;
+}
+
+bool FacWarMgr::Enlist(uint32 charID, uint32 factionID, bool letter, std::string& err)
+{
+    if (!CanEnlist(charID, factionID, letter, err))
+        return false;
+    uint32 militia(MilitiaCorpOf(factionID));
+    SaveEnlistment(charID, factionID, FacWar::CorpStatus::Active, GetFileTimeNow(), 0);
+    // employment history, session (warfactionid), and the ship's slim item
+    sCorpMgr.MoveMemberToCorp(charID, militia);
+    _log(FACWAR__INFO, "FacWarMgr:  %s(%u) enlisted in the %s militia%s", sDataMgr.GetOwnerName(charID).c_str(), charID, FactionName(factionID).c_str(),
+         (letter ? " with a letter of recommendation" : ""));
+    return true;
+}
+
+bool FacWarMgr::CanEnlistCorp(uint32 corpID, uint32 factionID, std::string& err) const
+{
+    if (!IsWarFaction(factionID)) {
+        err = "That faction has no militia.";
+        return false;
+    }
+    if (!IsPlayerCorp(corpID)) {
+        err = "Only a player corporation can enlist.";
+        return false;
+    }
+    if (WarFactionOf(corpID) != 0) {
+        err = "Your corporation is already in a militia.";
+        return false;
+    }
+    if (m_requests.find(corpID) != m_requests.end()) {
+        err = "Your corporation has already asked to join a militia.";
+        return false;
+    }
+    CorpData data = CorpData();
+        data.corporationID = corpID;
+    CorporationDB::GetCorpData(data);
+    if (data.allianceID != 0) {
+        err = "A corporation in an alliance can't enlist.";
+        return false;
+    }
+    float standing(CorpStandingOf(corpID, factionID));
+    if (standing < MinStanding) {
+        char buf[200];
+        snprintf(buf, sizeof(buf), "The %s militia takes corporations whose standing to it is %.1f or more.  Your corporation's is %.2f.",
+                 FactionName(factionID).c_str(), MinStanding, standing);
+        err = buf;
+        return false;
+    }
+    return true;
+}
+
+bool FacWarMgr::AskToJoin(uint32 corpID, uint32 factionID, uint32 byCharID, std::string& err)
+{
+    if (!CanEnlistCorp(corpID, factionID, err))
+        return false;
+    int64 now(GetFileTimeNow());
+    Request r;
+    r.factionID = factionID;
+    r.status = FacWar::CorpStatus::Joining;
+    r.askedAt = now;
+    r.effectiveAt = NextDowntime(now);
+    m_requests[corpID] = r;
+    SaveEnlistment(corpID, factionID, r.status, r.askedAt, r.effectiveAt);
+    _log(FACWAR__INFO, "FacWarMgr:  corp %u asks to join the %s militia (by %u), at the next downtime", corpID, FactionName(factionID).c_str(), byCharID);
+    return true;
+}
+
+bool FacWarMgr::AskToLeave(uint32 corpID, uint32 factionID, uint32 byCharID, std::string& err)
+{
+    if (!IsPlayerCorp(corpID) or (WarFactionOf(corpID) == 0) or ((factionID != 0) and (WarFactionOf(corpID) != factionID))) {
+        err = "Your corporation isn't in that militia.";
+        return false;
+    }
+    if (m_requests.find(corpID) != m_requests.end()) {
+        err = "Your corporation has already asked to leave its militia.";
+        return false;
+    }
+    int64 now(GetFileTimeNow());
+    Request r;
+    r.factionID = WarFactionOf(corpID);
+    r.status = FacWar::CorpStatus::Leaving;
+    r.askedAt = now;
+    r.effectiveAt = NextDowntime(now);
+    m_requests[corpID] = r;
+    SaveEnlistment(corpID, r.factionID, r.status, r.askedAt, r.effectiveAt);
+    _log(FACWAR__INFO, "FacWarMgr:  corp %u asks to leave the %s militia (by %u), at the next downtime", corpID, FactionName(r.factionID).c_str(), byCharID);
+    return true;
+}
+
+bool FacWarMgr::Withdraw(uint32 corpID, bool join, std::string& err)
+{
+    std::map<uint32, Request>::iterator itr = m_requests.find(corpID);
+    if ((itr == m_requests.end()) or (itr->second.status != (join ? FacWar::CorpStatus::Joining : FacWar::CorpStatus::Leaving))) {
+        err = (join ? "Your corporation hasn't asked to join a militia." : "Your corporation hasn't asked to leave its militia.");
+        return false;
+    }
+    uint32 factionID(itr->second.factionID);
+    m_requests.erase(itr);
+    if (join) {
+        sDatabase.RunQuery(s_err, "DELETE FROM facWarEnlistments WHERE ownerID = %u", corpID);
+    } else {
+        // it stays, as it enlisted
+        sDatabase.RunQuery(s_err, "UPDATE facWarEnlistments SET status = %u, effectiveAt = 0 WHERE ownerID = %u", FacWar::CorpStatus::Active, corpID);
+    }
+    _log(FACWAR__INFO, "FacWarMgr:  corp %u withdrew its %s the %s militia", corpID, (join ? "joining" : "leaving"), FactionName(factionID).c_str());
+    return true;
+}
+
+bool FacWarMgr::StatusOf(uint32 charID, uint32 corpID, uint32& factionID, uint8& status, int64& since) const
+{
+    factionID = 0;
+    status = FacWar::CorpStatus::Active;
+    since = 0;
+    std::map<uint32, Request>::const_iterator req = m_requests.find(corpID);
+    if (req != m_requests.end()) {
+        factionID = req->second.factionID;
+        status = req->second.status;
+        since = req->second.effectiveAt;
+        return true;
+    }
+    factionID = WarFactionOf(corpID);
+    if (factionID == 0)
+        return false;
+    // when it enlisted:  the character in a militia corporation, else its corporation
+    DBQueryResult res;
+    DBResultRow row;
+    if (sDatabase.RunQuery(res, "SELECT startDate FROM facWarEnlistments WHERE ownerID = %u", (IsMilitiaCorp(corpID) ? charID : corpID)) and res.GetRow(row))
+        since = row.GetInt64(0);
+    return true;
+}
+
+int64 FacWarMgr::NextDowntime(int64 now)
+{
+    int64 at(now - (now % EvE::Time::Day) + (int64)sConfig.alliance.ExecutorTallyHour * EvE::Time::Hour);
+    if (at <= now)
+        at += EvE::Time::Day;
+    return at;
+}
+
+/* ------------------------------------------------------------------------------------------------------------------
+ *  membership changes
+ * ------------------------------------------------------------------------------------------------------------------ */
+void FacWarMgr::SetCorpMilitia(uint32 corpID, uint32 factionID)
+{
+    uint32 before(WarFactionOf(corpID));
+    if (!sDatabase.RunQuery(s_err, "UPDATE crpCorporation SET warFactionID = %u WHERE corporationID = %u", factionID, corpID)) {
+        _log(FACWAR__ERROR, "FacWarMgr:  corp %u's militia not saved", corpID);
+        return;
+    }
+    if (factionID == 0)
+        m_corpFaction.erase(corpID);
+    else
+        m_corpFaction[corpID] = factionID;
+    // the online members' sessions (warfactionid) and their ships' slim items
+    std::vector<Client*> list;
+    sEntityList.GetCorpClients(list, corpID);
+    for (auto cur : list) {
+        if ((cur == nullptr) or (cur->GetChar().get() == nullptr))
+            continue;
+        CorpData data = cur->GetChar()->GetCorpData();
+        data.warFactionID = factionID;
+        cur->GetChar()->UpdateCorpData(data);
+    }
+    PyDict* change = new PyDict();
+        AddChange(change, "corporationID", new PyInt(corpID), new PyInt(corpID));
+        AddChange(change, "warFactionID", NullableInt(before), NullableInt(factionID));
+    sCorpMgr.BroadcastCorpChange(corpID, change);
+    _log(FACWAR__INFO, "FacWarMgr:  corp %u %s the %s militia", corpID, ((factionID != 0) ? "joined" : "left"),
+         FactionName((factionID != 0) ? factionID : before).c_str());
+}
+
+void FacWarMgr::CheckStandings(int64 now)
+{
+    uint32 warned(0), out(0);
+    // those who enlisted on their own:  their militia corporation's members
+    for (uint32 factionID : {(uint32)factionCaldari, (uint32)factionMinmatar, (uint32)factionAmarr, (uint32)factionGallente}) {
+        DBQueryResult res;
+        DBResultRow row;
+        if (!sDatabase.RunQuery(res, "SELECT c.characterID, IFNULL(s.standing, 0), IFNULL(e.warnedAt, 0) FROM chrCharacters AS c"
+                                     " LEFT JOIN repStandings AS s ON s.fromID = %u AND s.toID = c.characterID"
+                                     " LEFT JOIN facWarEnlistments AS e ON e.ownerID = c.characterID"
+                                     " WHERE c.corporationID = %u", factionID, MilitiaCorpOf(factionID)))
+            continue;
+        while (res.GetRow(row)) {
+            uint32 charID(row.GetUInt(0));
+            float standing((float)row.GetDouble(1));
+            int64 warnedAt(row.GetInt64(2));
+            if (standing >= MinStanding) {
+                if (warnedAt != 0)
+                    sDatabase.RunQuery(s_err, "UPDATE facWarEnlistments SET warnedAt = 0 WHERE ownerID = %u", charID);
+                continue;
+            }
+            if (warnedAt == 0) {
+                sDatabase.RunQuery(s_err, "INSERT INTO facWarEnlistments (ownerID, factionID, status, startDate, effectiveAt, warnedAt) VALUES (%u, %u, %u, 0, 0, %lli)"
+                                   " ON DUPLICATE KEY UPDATE warnedAt = %lli", charID, factionID, FacWar::CorpStatus::Active, now, now);
+                Tell(charID, "Your standing with the " + FactionName(factionID), "Your standing to the " + FactionName(factionID)
+                     + " has fallen below what its militia takes.  Unless it is back up by the next downtime, you will be removed from the militia.");
+                ++warned;
+                continue;
+            }
+            // a day after the warning
+            if ((now - warnedAt) < (EvE::Time::Day - EvE::Time::Hour))
+                continue;
+            sDatabase.RunQuery(s_err, "UPDATE facWarEnlistments SET warnedAt = 0 WHERE ownerID = %u", charID);
+            sCorpMgr.LeaveCorp(charID, false, charID);
+            Tell(charID, "Removed from the " + FactionName(factionID) + " militia", "Your standing to the " + FactionName(factionID)
+                 + " stayed below what its militia takes, and you have been removed from it.");
+            ++out;
+        }
+    }
+    // the corporations that enlisted
+    std::vector<std::pair<uint32, uint32>> corps;
+    for (auto& cur : m_corpFaction)
+        if (IsPlayerCorp(cur.first) and (m_requests.find(cur.first) == m_requests.end()))
+            corps.push_back(cur);
+    for (auto& cur : corps) {
+        uint32 corpID(cur.first), factionID(cur.second);
+        DBQueryResult res;
+        DBResultRow row;
+        int64 warnedAt(0);
+        if (sDatabase.RunQuery(res, "SELECT warnedAt FROM facWarEnlistments WHERE ownerID = %u", corpID) and res.GetRow(row))
+            warnedAt = row.GetInt64(0);
+        uint32 ceoID(CorporationDB::GetCorporationCEO(corpID));
+        if (CorpStandingOf(corpID, factionID) >= MinStanding) {
+            if (warnedAt != 0)
+                sDatabase.RunQuery(s_err, "UPDATE facWarEnlistments SET warnedAt = 0 WHERE ownerID = %u", corpID);
+            continue;
+        }
+        if (warnedAt == 0) {
+            sDatabase.RunQuery(s_err, "INSERT INTO facWarEnlistments (ownerID, factionID, status, startDate, effectiveAt, warnedAt) VALUES (%u, %u, %u, 0, 0, %lli)"
+                               " ON DUPLICATE KEY UPDATE warnedAt = %lli", corpID, factionID, FacWar::CorpStatus::Active, now, now);
+            Tell(ceoID, "Your corporation's standing with the " + FactionName(factionID), "Your corporation's standing to the " + FactionName(factionID)
+                 + " has fallen below what its militia takes.  Unless it is back up by the next downtime, your corporation will be removed from the militia.");
+            ++warned;
+            continue;
+        }
+        if ((now - warnedAt) < (EvE::Time::Day - EvE::Time::Hour))
+            continue;
+        sDatabase.RunQuery(s_err, "DELETE FROM facWarEnlistments WHERE ownerID = %u", corpID);
+        SetCorpMilitia(corpID, 0);
+        Tell(ceoID, "Removed from the " + FactionName(factionID) + " militia", "Your corporation's standing to the " + FactionName(factionID)
+             + " stayed below what its militia takes, and it has been removed from the militia.");
+        ++out;
+    }
+    if ((warned + out) > 0)
+        _log(FACWAR__INFO, "FacWarMgr:  standing check:  %u warned, %u removed from their militia", warned, out);
+}
diff --git a/src/eve-server/faction/FacWarMgr.h b/src/eve-server/faction/FacWarMgr.h
new file mode 100644
index 0000000..670a779
--- /dev/null
+++ b/src/eve-server/faction/FacWarMgr.h
@@ -0,0 +1,241 @@
+/**
+ * @name FacWarMgr.h
+ *   factional warfare's militias:  who is in which, enlisting and leaving, and which militias are at war
+ *
+ * @date:          22 October 2026
+ *
+ *   faction warfare's first stage.  Crucible's rules ("Empyrean Age and all that - Signing up", CCP 2008,
+ *   unchanged until Inferno):
+ *   - a character in an NPC corporation enlists at the militia office of a station of the faction's, with a standing of
+ *     0.5 or more to the faction (facwarMinStandingsToJoin), or with a Letter of Recommendation instead, and not within 24
+ *     hours of enlisting before.  it moves into the faction's militia corporation, and resigns by quitting it
+ *   - a player corporation's CEO or a director enlists the corporation, with the corporation's standing to the faction
+ *     (the average of its members' standings that aren't 0) 0.5 or more, and not while it's in an alliance or applying to
+ *     one.  it joins at the next downtime, and leaves at the downtime after it asks to.  alliances can't enlist
+ *   - a militia's members keep the standing it took to join:  below it they're warned, and a day later they're out
+ *   - the Amarr and Caldari militias are at war with the Gallente and Minmatar ones.  a militia's members may fight their
+ *     enemies' anywhere, high security too, without CONCORD (CrimeWatch::CanAttackFreely()), and the wars don't count
+ *     towards a corporation's own
+ *   a corporation's militia is its crpCorporation.warFactionID, as the session's warfactionid has it (the militia
+ *   corporations' own since this patch).  facWarEnlistments keeps who enlisted when, and the corporations' joins and
+ *   leaves waiting for downtime.  downtime is the hour the server counts alliance executors at (alliance.ExecutorTallyHour)
+ *
+ *   the second stage:  complexes and system control (FacWarSystems.cpp).  Crucible's rules (the Empyrean Age dev
+ *   blogs of 2008, "War is a full time job" of 2009):
+ *   - a war zone system is held by its occupier (facWarSystems.occupierID).  its complexes are cosmic anomalies, each held
+ *     by one of the zone's two factions:  the occupier's, which its enemy takes for victory points in the system, or, once
+ *     the enemy has some there, the enemy's, which the occupier takes to win them back
+ *   - a complex is taken by keeping a ship within its capture point's range (10, 20 or 30 km) for 10, 15 or 20 minutes
+ *     (minor, medium, major) with no ship of the holder's side in range.  how many ships doesn't matter;  the holder's side
+ *     alone in range winds it back.  the gates take what militia missions of levels 1, 2 and 3 allow
+ *   - at enough victory points the system's control bunker can be shot.  destroyed, the system goes to the faction that
+ *     destroyed it at the next downtime, and its victory points start over.  holding a system gives nothing else
+ *   picks:  victory points per complex (ComplexPoints()) and the threshold (VulnerableAt);  the holder's guards stop the
+ *   clock while any is left;  standing with your own faction of 0.0015 per victory point (the client's
+ *   facwarStandingPerVictoryPoint) for each pilot in range of a taken complex;  allies count on their ally's side;  about
+ *   two complexes a system, each taken one replaced half an hour to an hour and a half later somewhere in the war zones;
+ *   the bunker doesn't repair itself, but is whole again when the enemy's points are all won back
+ */
+
+#ifndef EVEMU_FACTION_FACWARMGR_H_
+#define EVEMU_FACTION_FACWARMGR_H_
+
+#include "eve-server.h"
+
+#include <unordered_map>
+#include <unordered_set>
+
+class AnomalyMgr;
+struct KillData;
+class SystemManager;
+
+class FacWarMgr
+: public Singleton<FacWarMgr>
+{
+public:
+    FacWarMgr();
+
+    // the corporations' militias, the joins and leaves waiting, and the war zones
+    int Initialize();
+    // once a minute:  the corporations' joins and leaves due, and the daily standing check at downtime
+    void Process();
+
+    /* the militias */
+    // the four empires have one
+    static bool IsWarFaction(uint32 factionID);
+    // the faction's militia corporation (0:  none), and back
+    static uint32 MilitiaCorpOf(uint32 factionID);
+    static uint32 FactionOfMilitiaCorp(uint32 corpID);
+    static bool IsMilitiaCorp(uint32 corpID)                        { return (FactionOfMilitiaCorp(corpID) != 0); }
+    // their militias are at war:  Amarr and Caldari against Gallente and Minmatar
+    static bool AreEnemies(uint32 factionA, uint32 factionB);
+    // the faction its militia's war zone is shared with (Amarr and Minmatar, Caldari and Gallente)
+    static uint32 ZoneEnemyOf(uint32 factionID);
+    // the corporation's militia (0:  none)
+    uint32 WarFactionOf(uint32 corpID) const;
+    // the corporations' militias are at war
+    bool EnemyCorps(uint32 corpA, uint32 corpB) const;
+    // ...they're in the same one
+    bool SameMilitia(uint32 corpA, uint32 corpB) const;
+    // the corporations in the faction's militia, its own first
+    void CorpsOf(uint32 factionID, std::vector<uint32>& into) const;
+    // the system is in the faction's war zone (facWarSystems)
+    bool InWarZone(uint32 systemID, uint32 factionID) const;
+
+    /* enlisting */
+    // the character's standing to the faction, and a corporation's (the average of its members' that aren't 0)
+    static float StandingOf(uint32 charID, uint32 factionID);
+    static float CorpStandingOf(uint32 corpID, uint32 factionID);
+    // the character may enlist in the faction's militia (with a letter of recommendation:  whatever its standing).  why not
+    bool CanEnlist(uint32 charID, uint32 factionID, bool letter, std::string& err) const;
+    // ...and does:  into its militia corporation
+    bool Enlist(uint32 charID, uint32 factionID, bool letter, std::string& err);
+    // the player corporation may enlist, and asks to (it joins at the next downtime)
+    bool CanEnlistCorp(uint32 corpID, uint32 factionID, std::string& err) const;
+    bool AskToJoin(uint32 corpID, uint32 factionID, uint32 byCharID, std::string& err);
+    // ...asks to leave (at the next downtime), and takes back what it asked
+    bool AskToLeave(uint32 corpID, uint32 factionID, uint32 byCharID, std::string& err);
+    bool Withdraw(uint32 corpID, bool join, std::string& err);
+    // a character's militia as the client's GetFactionalWarStatus() has it:  its corporation's, joining, in or leaving
+    bool StatusOf(uint32 charID, uint32 corpID, uint32& factionID, uint8& status, int64& since) const;
+
+    // the downtime after the time
+    static int64 NextDowntime(int64 now);
+
+    /* the war zones' systems */
+    // victory points that make a system's control bunker vulnerable
+    static const int32 VulnerableAt = 200;
+    // a complex's victory points, and how long it takes to capture (seconds), by size (1 minor, 2 medium, 3 major)
+    static int32 ComplexPoints(uint8 size);
+    static double CaptureSeconds(uint8 size);
+    // the factions are on the same side (the same, or allies)
+    static bool SameSide(uint32 factionA, uint32 factionB);
+    // the faction's control bunker type
+    static uint16 BunkerTypeOf(uint32 factionID);
+    // the system is in a war zone
+    bool IsZoneSystem(uint32 systemID) const                    { return (m_systems.find(systemID) != m_systems.end()); }
+    // its occupier (0:  not in a war zone), the victory points its enemy has there, and the client's contestion state
+    uint32 OccupierOf(uint32 systemID) const;
+    int32 VictoryPointsIn(uint32 systemID) const;
+    uint8 SystemStatus(uint32 systemID) const;
+    // the system's control bunker may be shot
+    bool BunkerVulnerable(uint32 systemID) const;
+
+    // a loaded system with pilots in it (AnomalyMgr::Process()):  its complexes and its bunker are there
+    void SyncSystem(SystemManager* pSystem, AnomalyMgr& anomMgr);
+    // the live site is a complex
+    bool IsComplexSite(uint32 instanceID) const                 { return (m_complexOfSite.find(instanceID) != m_complexOfSite.end()); }
+    // its size and holder (false:  no complex)
+    bool ComplexOf(uint32 instanceID, uint8& size, uint32& holderID) const;
+    /* a second (or more) of a complex's capture (DungeonMgr::Process()):  the pilots in its capture point's range on the
+     *  attacker's side, how many of the holder's side, and how many guards are left.  true:  it's taken */
+    bool CaptureTick(uint32 instanceID, const std::vector<uint32>& takers, uint32 holders, uint32 guards, double seconds);
+    // the system's control bunker (ControlBunkerSE):  what's left of it, hit or not, and its end
+    void GetBunkerHealth(uint32 systemID, double& shield, double& armor, double& hull) const;
+    void OnBunkerDamaged(uint32 systemID, double shield, double armor, double hull);
+    void OnBunkerDestroyed(uint32 systemID, uint32 charID);
+
+    // the client's:  facWarMgr.GetFWSystems(), map.GetVictoryPoints() and facWarMgr.GetSystemsConqueredThisRun()
+    PyRep* GetFWSystems() const;
+    PyRep* GetVictoryPoints() const;
+    PyRep* GetSystemsConquered() const;
+
+    // GM (/fw):  a system's state, its victory points, more complexes there now, and the downtime flips now
+    std::string Describe(uint32 systemID) const;
+    void SetVictoryPoints(uint32 systemID, int32 points);
+    void AddComplexes(SystemManager* pSystem, uint8 count);
+    void FlipConquered();
+    // counts for the log:  complexes, live ones, taken since the start, systems contested, vulnerable and conquered
+    void Stats(uint32& complexes, uint32& live, uint32& taken, uint32& contested, uint32& vulnerable, uint32& conquered) const;
+
+    /* ranks and loyalty points for kills (FacWarRewards.cpp) */
+    // the rank a militia pilot has with its faction at a standing with it (Crucible's ranks go by standing):  0 under 1.0,
+    //  then one more for each point of standing, to 9
+    static uint8 RankAt(float standing);
+    // ...the character's with the faction now, saved with the highest it reached.  changed:  not the rank last saved
+    uint8 UpdateRank(uint32 charID, uint32 factionID, bool& changed);
+    // the character's ranks (currentRank, highestRank, factionID, lastModified), its militia's (factionID) brought up to date
+    PyRep* RankRows(uint32 charID, uint32 factionID);
+    /* a kill (ServiceDB::SaveKillOrLoss()):  an enemy militia pilot's ship destroyed pays loyalty points in their militias to
+     *  its militia attackers, shared between them.  what the hull's worth (KillPoints()), more for a higher ranked victim
+     */
+    void OnKill(const KillData& data);
+    // ...the loyalty points a kill of the hull pays its attackers in all, by the victim's rank (0:  none, a pod)
+    static uint32 KillPoints(uint32 shipTypeID, uint8 victimRank);
+    // kills that paid loyalty points, and the points, since the start
+    uint32 KillsPaid() const                                    { return m_killsPaid; }
+    uint32 KillPointsPaid() const                               { return m_killPoints; }
+
+private:
+    struct Request {
+        uint32 factionID = 0;
+        uint8 status = 0;               // FacWar::CorpStatus:  Joining or Leaving
+        int64 askedAt = 0;
+        int64 effectiveAt = 0;          // the downtime it takes effect at
+    };
+
+    // the corporation is in the militia (factionID) or out of it (0) now:  its row, its members' sessions and ships
+    void SetCorpMilitia(uint32 corpID, uint32 factionID);
+    // members below the standing their militia takes:  warned, then out a day later
+    void CheckStandings(int64 now);
+
+    // complexes a war zone system starts with, and after it changes hands
+    static const uint8 ComplexesPerSystem = 2;
+
+    struct Complex {
+        uint32 systemID = 0;
+        uint32 holderID = 0;            // the faction whose it is:  its guards and capture point
+        uint8 size = 1;                 // 1 minor, 2 medium, 3 major
+        uint32 dungeonID = 0;
+        uint32 siteID = 0;              // its live site (DungeonMgr instance) while its system is loaded
+        double progress = 0;            // seconds of capturing done
+        int64 lastTold = 0;             // the takers were last told how it goes
+    };
+    struct ZoneSystem {
+        uint32 factionID = 0;           // whose war zone it's in
+        uint32 occupierID = 0;
+        int32 points = 0;               // the occupier's enemy's victory points here
+        uint32 capturedBy = 0;          // destroyed the bunker:  takes the system at the downtime after capturedAt
+        int64 capturedAt = 0;
+        double shield = 1.0, armor = 1.0, hull = 1.0;   // the bunker's
+        uint32 bunkerID = 0;            // its live bunker while the system is loaded
+        bool dirty = false;
+    };
+
+    void LoadSystems();
+    void SaveSystem(uint32 systemID);
+    // a new complex in the system:  the occupier's, or the enemy's once it has points there (DefensiveShare)
+    void AddComplex(uint32 systemID);
+    // a complex is gone (taken, or its system changed hands):  its live site too
+    void RemoveComplex(uint32 complexID);
+    void Captured(uint32 complexID, const std::vector<uint32>& takers);
+    // the bunker's whole again (its live one too)
+    void RepairBunker(uint32 systemID);
+    // its live bunker:  put up, with what's left of it, and on the scanner
+    void SpawnBunker(SystemManager* pSystem, AnomalyMgr& anomMgr, ZoneSystem& sys);
+    // the dungeon of a complex of this holder and size
+    uint32 PickDungeon(uint32 holderID, uint8 size, bool gated) const;
+    // tell everyone in space in the system
+    void TellSystem(uint32 systemID, const std::string& text);
+
+    std::map<uint32, Complex> m_complexes;                      // ours, from 1
+    std::unordered_map<uint32, uint32> m_complexOfSite;         // live site:  its complex
+    std::unordered_map<uint32, ZoneSystem> m_systems;           // war zone system:
+    std::multimap<int64, uint32> m_newComplexes;                // due:  a complex for a random war zone system
+    uint32 m_nextComplexID;
+    bool m_seeded;                                              // the war zones got their first complexes (the dungeons load after us)
+    uint32 m_taken;
+    uint32 m_killsPaid;
+    uint32 m_killPoints;
+    int64 m_lastSave;
+
+    std::unordered_map<uint32, uint32> m_corpFaction;           // corporation:  its militia
+    std::map<uint32, Request> m_requests;                       // corporation:  its join or leave waiting
+    std::unordered_map<uint32, uint32> m_zone;                  // war zone system:  its faction (facWarSystems.factionID)
+    int64 m_lastCheckDay;
+};
+
+#define sFacWarMgr \
+( FacWarMgr::get() )
+
+#endif  // EVEMU_FACTION_FACWARMGR_H_
diff --git a/src/eve-server/faction/FacWarRewards.cpp b/src/eve-server/faction/FacWarRewards.cpp
new file mode 100644
index 0000000..04abcc7
--- /dev/null
+++ b/src/eve-server/faction/FacWarRewards.cpp
@@ -0,0 +1,119 @@
+/**
+ * @name FacWarRewards.cpp
+ *   factional warfare's ranks and loyalty points for kills.  see FacWarMgr.h
+ *
+ *   a militia pilot's rank with its faction goes by its standing with the faction, as in Crucible:  0 under 1.0, then one
+ *     more a point of standing, to 9.  the client asks for it (GetMyCharacterRankOverview, CheckForRankChange), and the
+ *     highest a pilot reached is kept.
+ *   a kill of an enemy militia pilot's ship pays the militia pilots on the kill loyalty points in their militias, as on
+ *     Tranquility since 2012:  a point for each 10,000 ISK of the hull's base price, a tenth more for each of the victim's
+ *     ranks, shared between them.  that and the rank multiplier are picks.  a pod pays nothing
+ *
+ * @date:          22 October 2026
+ */
+
+#include "eve-server.h"
+
+#include "EVE_Defines.h"
+
+#include "POD_containers.h"
+#include "StaticDataMgr.h"
+#include "corporation/LPService.h"
+#include "database/EVEDBUtils.h"
+#include "faction/FacWarMgr.h"
+#include "inventory/InventoryItem.h"
+#include "inventory/ItemFactory.h"
+#include "inventory/ItemType.h"
+#include "killboard/KillboardData.h"
+#include "standing/StandingDB.h"
+
+namespace {
+    // loyalty points a kill pays in all:  one for this much ISK of the hull's base price, and this much more a victim's rank
+    const double IskPerPoint = 10000.0, PerVictimRank = 0.1;
+    const uint8 TopRank = 9;
+    DBerror s_err;
+}
+
+uint8 FacWarMgr::RankAt(float standing)
+{
+    if (standing < 1.0f)
+        return 0;
+    return (uint8)EvE::min((int)standing, (int)TopRank);
+}
+
+uint8 FacWarMgr::UpdateRank(uint32 charID, uint32 factionID, bool& changed)
+{
+    changed = false;
+    if ((charID == 0) or (MilitiaCorpOf(factionID) == 0))
+        return 0;
+    uint8 rank(RankAt(StandingDB::GetStanding(factionID, charID)));
+    DBQueryResult res;
+    DBResultRow row;
+    if (sDatabase.RunQuery(res, "SELECT currentRank, highestRank FROM facWarRanks WHERE characterID = %u AND factionID = %u", charID, factionID)
+    and res.GetRow(row)) {
+        if (row.GetInt(0) == rank)
+            return rank;
+        changed = true;
+        sDatabase.RunQuery(s_err, "UPDATE facWarRanks SET currentRank = %u, highestRank = GREATEST(highestRank, %u), lastModified = %lli"
+                           " WHERE characterID = %u AND factionID = %u", rank, rank, (int64)GetFileTimeNow(), charID, factionID);
+        return rank;
+    }
+    // its first:  a rank above 0 is news
+    changed = (rank > 0);
+    sDatabase.RunQuery(s_err, "INSERT INTO facWarRanks (characterID, factionID, currentRank, highestRank, lastModified) VALUES (%u, %u, %u, %u, %lli)",
+                       charID, factionID, rank, rank, (int64)GetFileTimeNow());
+    return rank;
+}
+
+PyRep* FacWarMgr::RankRows(uint32 charID, uint32 factionID)
+{
+    bool changed(false);
+    if (factionID != 0)
+        UpdateRank(charID, factionID, changed);
+    DBQueryResult res;
+    if (!sDatabase.RunQuery(res, "SELECT currentRank, highestRank, factionID, lastModified FROM facWarRanks WHERE characterID = %u", charID))
+        codelog(DATABASE__ERROR, "FacWarMgr::RankRows() - %s", res.error.c_str());
+    return DBResultToCRowset(res);
+}
+
+uint32 FacWarMgr::KillPoints(uint32 shipTypeID, uint8 victimRank)
+{
+    const ItemType* pType(sItemFactory.GetType(shipTypeID));
+    if ((pType == nullptr) or (pType->groupID() == EVEDB::invGroups::Capsule) or (pType->categoryID() != EVEDB::invCategories::Ship))
+        return 0;
+    return (uint32)(pType->basePrice() / IskPerPoint * (1.0 + PerVictimRank * victimRank));
+}
+
+void FacWarMgr::OnKill(const KillData& data)
+{
+    if (!IsCharacterID(data.victimCharacterID) or (MilitiaCorpOf(data.victimFactionID) == 0))
+        return;
+    uint32 points(KillPoints(data.victimShipTypeID, RankAt(StandingDB::GetStanding(data.victimFactionID, data.victimCharacterID))));
+    if (points == 0)
+        return;
+    // the victim's enemies on the kill, each in its militia now
+    std::vector<KbAttacker> attackers;
+    KillboardData::ParseAttackers(data.killBlob, attackers);
+    std::map<uint32, uint32> paid;      // character -> its militia
+    for (auto& cur : attackers) {
+        if (!IsCharacterID(cur.charID) or (paid.find(cur.charID) != paid.end()))
+            continue;
+        uint32 factionID(WarFactionOf(cur.corpID));
+        if ((factionID != 0) and AreEnemies(factionID, data.victimFactionID))
+            paid[cur.charID] = factionID;
+    }
+    if (IsCharacterID(data.finalCharacterID) and (paid.find(data.finalCharacterID) == paid.end())) {
+        uint32 factionID(WarFactionOf(data.finalCorporationID));
+        if ((factionID != 0) and AreEnemies(factionID, data.victimFactionID))
+            paid[data.finalCharacterID] = factionID;
+    }
+    if (paid.empty())
+        return;
+    uint32 share((points > paid.size()) ? points / (uint32)paid.size() : 1);
+    for (auto& cur : paid)
+        LPService::AddLP(cur.first, MilitiaCorpOf(cur.second), share);
+    ++m_killsPaid;
+    m_killPoints += share * (uint32)paid.size();
+    _log(FACWAR__INFO, "FacWarMgr::OnKill() - %s's %s in %u:  %u loyalty points to each of %u militia pilots", sDataMgr.GetOwnerName(data.victimCharacterID).c_str(),
+         sDataMgr.GetTypeName(data.victimShipTypeID), data.solarSystemID, share, (uint32)paid.size());
+}
