+int32 FacWarMgr::ComplexPoints(uint8 size)
+{
+    return 10 * std::max<int32>(size, 1);
+}
+
+double FacWarMgr::CaptureSeconds(uint8 size)
+{
+    // ten, fifteen and twenty minutes
+    return 300.0 * (1 + std::max<int32>(size, 1));
+}
