+++ b/src/eve-server/system/DestinyManager.cpp
@@ -157,7 +157,12 @@ void DestinyManager::ProcessState() {
                 MoveObject();
                 return;
             }
-            Stop();
+            // already stopped: Stop() sends a Stop command to every client in the bubble, so only call it
+            //  if this object has not been stopped yet.  Sending it every tic stopped the player's ship at the
+            //  end of warp while the client was still landing (the warp 'bounce'), and the client's autopilot
+            //  treats a Stop it did not ask for as manual control and switches itself off (after every jump).
+            if (!m_stop)
+                Stop();
         } break;
         case Ball::Mode::GOTO: {
             MoveObject();
@@ -1140,6 +1145,10 @@ void DestinyManager::Follow() {
                 // this will mimic real movement, where ship will decel instead of a sudden halt
                 //  still need to call MoveObject() here
                 SetSpeedFraction(0.2);
+            } else if (mySE->HasPilot()) {
+                // a player's client holds its own ship at the follow range.  Sending it a Stop here cancels the
+                //  client's autopilot, which approaches nearby gates this way and then jumps.
+                return;
             } else {
                 Stop();
             }
