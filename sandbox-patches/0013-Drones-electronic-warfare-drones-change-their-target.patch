diff --git a/src/eve-server/npc/DroneAI.cpp b/src/eve-server/npc/DroneAI.cpp
index f73cbab4..b2b9f048 100644
--- a/src/eve-server/npc/DroneAI.cpp
+++ b/src/eve-server/npc/DroneAI.cpp
@@ -35,7 +35,11 @@
 #include "inventory/Inventory.h"
 #include "npc/Drone.h"
 #include "npc/DroneAI.h"
+#include "npc/NPC.h"
+#include "npc/NPCAI.h"
 #include "ship/Ship.h"
