From 6c20aa3db76f55a556f039decffca29d29d81f0a Mon Sep 17 00:00:00 2001
From: AzediZ <145237384+AzediZ@users.noreply.github.com>
Date: Wed, 14 Oct 2026 15:06:31 +0000
Subject: [PATCH 49/50] Docker: a fresh universe in the db_revised volume

The database volume is now db_revised, so this code base starts with a new
universe and the old one stays untouched in the db volume.  The server and
image caches move to server_cache_revised and image_cache_revised with it:
server_cache holds static data read from the database, and the server loads
it from there before asking the database.

SEED_MARKET, SEED_SATURATION and SEED_REGIONS are gone: nothing reads them
since db_init.sh stopped seeding the market.
---
 docker-compose.yml | 19 +++++++++----------
 1 file changed, 9 insertions(+), 10 deletions(-)

diff --git a/docker-compose.yml b/docker-compose.yml
index a3ee1934..badceafb 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -1,6 +1,6 @@
 services:
   server:
-    image: "evemu_server"
+    image: "evemu_server_revised" # its own name, so an image built from the old code base is never started on this universe
     build: #Build image from source repository
       context: .
       args:
@@ -8,8 +8,9 @@ services:
     container_name: server
     volumes:
       - ./config:/app/etc
-      - server_cache:/app/server_cache
-      - image_cache:/app/image_cache
+      # the caches belong to the universe in db_revised:  server_cache keeps static data read from that database
+      - server_cache_revised:/app/server_cache
+      - image_cache_revised:/app/image_cache
     ports:
       - "26000:26000"
       - "26001:26001"
@@ -18,9 +19,6 @@ services:
     links:
       - "db"
     environment:
-      - SEED_MARKET=${SEED_MARKET:-FALSE} # Set to TRUE to seed the market when the server starts for the first time
-      - SEED_SATURATION=${SEED_SATURATION:-80} # Set saturation level of seed
-      - SEED_REGIONS=${SEED_REGIONS:-Derelik,The Citadel,The Forge,Essence} # Define regions to be seeded
       - RUN_WITH_GDB=${RUN_GDB:-FALSE} #Set to TRUE to run evemu with gdb automatically
     stdin_open: true # Enables stdin for the container. Attach to it with 'docker attach'
     tty: true
@@ -36,7 +34,8 @@ services:
     image: "mariadb:11.8"
     container_name: db
     volumes:
-      - db:/var/lib/mysql
+      # the universe.  db_revised is a fresh database for this code base;  the old universe stays in the db volume
+      - db_revised:/var/lib/mysql
     # If you want to connect to the Database pick your host port to map it to, (host-port:container-port) below. 
     #ports:
     #  - "3306:3306"  
@@ -47,7 +46,7 @@ services:
       - MARIADB_DATABASE=evemu
 
 volumes:
-  db:
-  server_cache:
-  image_cache:
+  db_revised:
+  server_cache_revised:
+  image_cache_revised:
 
-- 
