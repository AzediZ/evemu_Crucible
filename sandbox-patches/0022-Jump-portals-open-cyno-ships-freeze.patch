From 914871a1e0c5cedf13f10e83d1bccf5021303b6d Mon Sep 17 00:00:00 2001
From: AzediZ <145237384+AzediZ@users.noreply.github.com>
Date: Mon, 12 Oct 2026 18:11:19 +0000
Subject: [PATCH] Jump portals open; cyno ships freeze

JumpPortalModule::OpenPortal() treated m_Stop as a failed activation, but a one-cycle activation
(repeat 1) always sets m_Stop at the end of ActiveModule::Activate(), so every "Bridge to" was
refused without a message. Check the module state only, and tell the pilot when the generator
doesn't start.

CynoModule::Activate() had the same check, so it returned before freezing the ship and saving
its max velocity; DeactivateCycle() then set the ship's max velocity to 0.
---
 src/eve-server/ship/BeyonceService.cpp           | 5 ++++-
 src/eve-server/ship/modules/CynoModule.cpp       | 5 +++--
 src/eve-server/ship/modules/JumpPortalModule.cpp | 4 +++-
 3 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/src/eve-server/ship/BeyonceService.cpp b/src/eve-server/ship/BeyonceService.cpp
index 9bb180b..847f322 100644
--- a/src/eve-server/ship/BeyonceService.cpp
+++ b/src/eve-server/ship/BeyonceService.cpp
@@ -969,8 +969,11 @@ static void OpenJumpPortal(Client* pClient, const JumpDrive::Beacon& beacon)
     if (!JumpDrive::CheckRange(pClient, pClient->GetShip(), beacon.systemID, "jump portal"))
         return;
 
-    if (pPortal->OpenPortal(beacon))
+    if (pPortal->OpenPortal(beacon)) {
         pClient->SendNotifyMsg("Jump portal open.  Fleet members within %.0f m of your ship can jump through it.", JumpDrive::PortalUseRange);
+    } else {
+        pClient->SendNotifyMsg("Your jump portal generator didn't start.");
+    }
 }
 
 PyResult BeyonceBound::CmdBridgeToMember(PyCallArgs &call, PyInt* charID, PyInt* beaconID, PyInt* solarSystemID) {
diff --git a/src/eve-server/ship/modules/CynoModule.cpp b/src/eve-server/ship/modules/CynoModule.cpp
index 6104128..50eede3 100644
--- a/src/eve-server/ship/modules/CynoModule.cpp
+++ b/src/eve-server/ship/modules/CynoModule.cpp
@@ -38,8 +38,9 @@ void CynoModule::Activate(uint16 effectID, uint32 targetID, int16 repeat)
     m_firstRun = true;
     ActiveModule::Activate(effectID, targetID, repeat);
 
-    // check to see if Activate() was denied.
-    if (m_Stop)
+    // check to see if Activate() was denied.  check the state, not m_Stop: a single-cycle activation sets m_Stop
+    //  straight away, which skipped freezing the ship
+    if (GetModuleState() != Module::State::Activated)
         return;
 
     _log(MODULE__DEBUG, "Cynosural field generator activated by %s in %s", pClient->GetName(), m_sysMgr->GetName());
diff --git a/src/eve-server/ship/modules/JumpPortalModule.cpp b/src/eve-server/ship/modules/JumpPortalModule.cpp
index b5d1d0b..f7c73fe 100644
--- a/src/eve-server/ship/modules/JumpPortalModule.cpp
+++ b/src/eve-server/ship/modules/JumpPortalModule.cpp
@@ -35,7 +35,9 @@ bool JumpPortalModule::OpenPortal(const JumpDrive::Beacon& beacon)
 
     // one cycle.  this throws the usual activation errors (capacitor, fuel, offline...)
     ActiveModule::Activate(m_modRef->type().GetDefaultEffect(), 0, 1);
-    if (m_Stop or (GetModuleState() != Module::State::Activated))
+    // check the state only.  a one-cycle activation always sets m_Stop (stop when this cycle ends), so checking it
+    //  here refused every portal
+    if (GetModuleState() != Module::State::Activated)
         return false;
 
     m_beacon = beacon;
