        <loginInfo>true</loginInfo><!-- bool  -send the server info MOTD into local on login -->
        <loginMsg>true</loginMsg><!-- bool  -show account/loginMessage after authentication -->
        <mailDelay>5</mailDelay><!-- seconds  -minimum time between eve mails sent by one character (anti-spam).  0 = off -->
        <apWarptoDistance>15000</apWarptoDistance><!-- in meters - sets autopilot warp stop distance from object (15km default)-->
        <saveOnMove>true</saveOnMove><!-- bool - save items when Move()'d -->
        <saveOnUpdate>true</saveOnUpdate><!-- bool - save items when values or attributes updated -->
        <shipBoardDistance>6550</shipBoardDistance><!-- int  - max surface distance (meters) to board a ship in space.  the client's maxBoardingDistance (6550 default) -->
