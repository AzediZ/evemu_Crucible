        <SecureContainerOwnerBypass>true</SecureContainerOwnerBypass><!-- bool - owners open their own password-protected containers in their station hangar or ship without the password.  corp containers, containers in space and other people's always ask -->
        <fleetWarpSlowestSpeed>true</fleetWarpSlowestSpeed><!-- bool - every ship in a fleet warp uses the slowest warp speed among them.  Crucible: true -->
        <fleetInviteTimeout>120</fleetInviteTimeout><!-- seconds an unanswered fleet invite lasts; then the position it holds is free again and the inviter is told the invitee did not respond.  0 = invites never time out -->
    </world>

