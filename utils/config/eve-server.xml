        <PIRichnessNullsec>1.0</PIRichnessNullsec><!-- float.  base richness of planets in null security and wormholes -->
        <PIDepletionEnabled>true</PIDepletionEnabled><!-- bool.  extraction programs deplete the resource around their heads, which grows back over time -->
        <PIDepletionPerUnit>0.0001</PIDepletionPerUnit><!-- float.  resource value removed at a head per unit extracted -->
        <PIDepletionMaxFraction>0.6</PIDepletionMaxFraction><!-- float.  at most this part of the resource at a head can be depleted -->
        <PIDepletionRadius>1.5</PIDepletionRadius><!-- float.  size of the depleted area, in head radii -->
        <PIDepletionRegenHours>168</PIDepletionRegenHours><!-- float.  half-life of depletion in hours once the program is done -->
        <PIGantryMaxDistanceKm>100000</PIGantryMaxDistanceKm><!-- float.  a Customs Office Gantry anchors no further than this from the planet surface (km) -->
    </cosmic>

    <exploring><!--  control amount of specific sites per system (adjusted by truSec) -->
        <Gravametric>5</Gravametric><!-- integer  -1 to disable.  max 128.  default 5 -->
        <Magnetometric>3</Magnetometric><!-- integer  -1 to disable.  max 128.  default 3 -->
        <Ladar>6</Ladar><!-- integer  -1 to disable.  max 128.  default 6 -->
        <Radar>6</Radar><!-- integer  -1 to disable.  max 128.  default 6 -->
        <Unrated>8</Unrated><!-- integer  -1 to disable.  max 128.  default 8 -->
        <Complex>4</Complex><!-- integer  -1 to disable.  max 128.  default 4 -->
        <DScanCooldown>2000</DScanCooldown><!-- ms between directional scans of one character (client ConeScanTooFrequent).  0 = no limit.  default 2000 -->
        <SurveyProbeConeAngle>30.0</SurveyProbeConeAngle><!-- float degrees  a survey probe flies to the moon nearest the ship's heading within this angle.  default 30.0 -->
        <ProbeStrengthScale>1.0</ProbeStrengthScale><!-- float  multiplier on every scanner probe's strength (tuning).  default 1.0 -->
        <ProbeShipSigDivisor>25.0</ProbeShipSigDivisor><!-- float  ships, drones and structures scan like a site of signal size (signature radius / this) percent.  lower = easier to probe.  default 25.0 -->
    </exploring>

    <dungeon><!-- dungeons: combat anomalies, signature sites, acceleration gates and escalations (needs cosmic DungeonEnabled) -->
        <AnomalyLifetime>0</AnomalyLifetime><!-- hours an untouched combat anomaly lives.  0 = until it is completed (Crucible).  default 0 -->
        <SignatureLifetime>72</SignatureLifetime><!-- hours an untouched signature site lives (+-25%).  0 = until completed.  default 72 -->
        <CompletedDespawn>120</CompletedDespawn><!-- seconds after completion before the site's objects and npcs are removed.  default 120 -->
        <RespawnDelay>300</RespawnDelay><!-- seconds before a completed or expired site is replaced elsewhere in its system.  default 300 -->
        <EscalationChance>1.0</EscalationChance><!-- float  multiplier on the escalation chances of dunEscalations.  default 1.0 -->
        <EscalationExpiry>48</EscalationExpiry><!-- hours an escalation stays in the journal (client dunExpirationDelay).  default 48 -->
        <EscalationShareFleet>false</EscalationShareFleet><!-- bool  fleet members in the system also get the escalation (Crucible: only the pilot who triggered it).  default false -->
        <GateKeysRequired>true</GateKeysRequired><!-- bool  acceleration gate keys are required (and consumed where the gate says so).  default true -->
        <TriggerMessages>true</TriggerMessages><!-- bool  send dungeon trigger messages (wave warnings, story text) to local.  default true -->
    </dungeon>

    <missions><!-- agent missions (F12).  reward numbers approximate Crucible payouts (no period source has the base tables) -->
        <OfferExpiryHours>168</OfferExpiryHours><!-- hours a mission offer stays in the journal.  default 168 (Crucible ~7 days) -->
        <AcceptedExpiryHours>168</AcceptedExpiryHours><!-- hours to complete an accepted mission before it fails (standings loss).  default 168 -->
        <DeclinePenaltyHours>4</DeclinePenaltyHours><!-- a second decline with the same agent within this many hours costs standings.  default 4 -->
        <UseDivisionTypes>true</UseDivisionTypes><!-- bool  Security agents give encounters, Distribution courier, Mining mining missions (Incursion 1.5).  false = courier only.  default true -->
        <FallbackToCourier>true</FallbackToCourier><!-- bool  an agent with no content for its mission type offers a courier mission instead of none.  default true -->
        <BaseISK1>40000</BaseISK1><!-- default level 1 reward before security and Negotiation (content rows may set their own) -->
        <BaseISK2>160000</BaseISK2>
        <BaseISK3>450000</BaseISK3>
        <BaseISK4>900000</BaseISK4>
        <BaseISK5>6000000</BaseISK5>
        <BonusISK1>30000</BonusISK1><!-- default level 1 time bonus -->
        <BonusISK2>120000</BonusISK2>
        <BonusISK3>350000</BonusISK3>
        <BonusISK4>750000</BonusISK4>
        <BonusISK5>4000000</BonusISK5>
        <BonusMinutes1>60</BonusMinutes1><!-- default level 1 bonus window in minutes after accepting -->
        <BonusMinutes2>90</BonusMinutes2>
        <BonusMinutes3>120</BonusMinutes3>
        <BonusMinutes4>180</BonusMinutes4>
        <BonusMinutes5>240</BonusMinutes5>
        <BaseLP1>200</BaseLP1><!-- default level 1 base LP.  LP = base x (1.6288 - agent system security) x (1 + 10% per division Connections level) -->
        <BaseLP2>600</BaseLP2>
        <BaseLP3>1500</BaseLP3>
        <BaseLP4>3500</BaseLP4>
        <BaseLP5>12000</BaseLP5>
        <IskSecurityScaling>true</IskSecurityScaling><!-- bool  ISK rewards are also scaled by (1.6288 - security).  default true -->
        <FleetShare>true</FleetShare><!-- bool  a pilot in a fleet is asked whether to share ISK, LP and agent/corp standings.  default true -->
        <FleetShareMax>10</FleetShareMax><!-- max pilots sharing, the completer included.  default 10 (Crucible) -->
        <FleetShareSameSystem>true</FleetShareSameSystem><!-- bool  only fleet members in the completer's system share.  default true -->
        <DungeonDespawnMinutes>120</DungeonDespawnMinutes><!-- minutes a mission pocket stays after completion, quit or failure (salvaging).  default 120 -->
        <StorylineEvery>16</StorylineEvery><!-- missions of one level for one faction before a storyline mission is offered.  default 16 (Crucible) -->
        <GateRestrictions>true</GateRestrictions><!-- bool  mission acceleration gates enforce the mission level's ship restrictions.  default true -->
    </missions>

    <agents><!-- research (R&D) and locator agents (F24) -->
        <researchDatacoreRP>100</researchDatacoreRP><!-- research points a datacore costs.  default 100 -->
        <researchDatacoreISK>0</researchDatacoreISK><!-- ISK a datacore costs on top.  default 0 (Crucible; Inferno, May 2012, made it 10000) -->
        <researchFieldMultipliers>true</researchFieldMultipliers><!-- bool  pre-Inferno research field multipliers (starship engineering x3, graviton/plasma physics x2).  false = every field x1 -->
        <locatorEnabled>true</locatorEnabled><!-- bool  locator agents find characters.  default true -->
    </agents>

    <testing><!-- switches for various incomplete/testing code sections -->
        <EnableDrones>true</EnableDrones><!-- bool -->
    </testing>

    <debug><!-- switches for various server methods -->
        <BubbleTrack>false</BubbleTrack><!-- bool - create jetcans at center and edges of bubble (7 per bubble) -->
        <SpawnTest>false</SpawnTest><!-- bool - enables 5s respawn timer -->
        <IsTestServer>true</IsTestServer>  <!--  bool   -some functions disabled for live server -->
        <UseProfiling>false</UseProfiling><!-- bool  - use internal memobj code profiling system -->
        <ProfileTraceTime>5000</ProfileTraceTime><!-- msec  profile time above this will print StackTrace  default: 500 -->
        <UseShipTracking>false</UseShipTracking><!-- bool -->
        <PositionHack>false</PositionHack><!-- bool -->
        <DeleteTrackingCans>false</DeleteTrackingCans><!-- bool - no longer used -->
        <AnomalyFaction>0</AnomalyFaction><!-- force anomaly to this faction if !=0   -this is for testing dung spawn system -->
    </debug>

    <crime><!-- Crucible (pre-Retribution) crime rules, CONCORD, faction police, sentries and logoff timers -->
        <Enabled>true</Enabled><!-- bool -->
        <CrimFlagTime>900</CrimFlagTime> <!-- seconds the global criminal countdown lasts (15m default) -->
        <AggFlagTime>900</AggFlagTime> <!-- seconds an aggression flag lasts (15m default) -->
        <WeaponFlagTime>60</WeaponFlagTime> <!-- seconds after an aggressive act before you may dock or jump (60s default) -->
        <KillRightDays>30</KillRightDays> <!-- days a kill right lasts -->
        <LogoffNPCTime>120</LogoffNPCTime> <!-- seconds a logged-off ship stays in space when NPCs were attacking it -->
        <LogoffWarpTime>60</LogoffWarpTime> <!-- seconds a logged-off ship takes to warp off and vanish otherwise.  PvP aggression keeps it for AggFlagTime -->
        <SecGainWindow>900</SecGainWindow> <!-- seconds.  only the best npc kill per system in this window raises security status -->
        <SecAggressionPenalty>1.5</SecAggressionPenalty> <!-- % of the distance to -10, scaled by system security -->
        <SecShipKillPenalty>6.0</SecShipKillPenalty>
        <SecPodKillPenalty>37.5</SecPodKillPenalty>
        <SecPodKillMinPenalty>12.5</SecPodKillMinPenalty>
        <CriminalLockdown>true</CriminalLockdown><!-- criminals can't use gates or stations in empire space, except in a capsule -->
        <SwitchShipWeaponsTimer>false</SwitchShipWeaponsTimer><!-- bool - no ejecting, boarding or storing ships while the weapons timer runs (the Retribution rule).  Crucible: false (only criminals can't switch ships) -->
        <Concord>true</Concord><!-- bool -->
        <ConcordResponse>2,5,10,15,20,25</ConcordResponse><!-- response seconds in 1.0, 0.9, 0.8, 0.7, 0.6, 0.5 systems.  default: the closest pre-Crucible measurements (npc ai plan, open question 3) -->
        <ConcordWaves>false</ConcordWaves><!-- true: police officers and captains arrive first, the commander ConcordWaveDelay later -->
        <ConcordWaveDelay>10</ConcordWaveDelay>
        <ConcordLinger>60</ConcordLinger><!-- seconds CONCORD stays after the criminal's ship is gone -->
        <FactionPolice>true</FactionPolice><!-- chase low security status pilots in high-sec -->
        <PoliceDelay>15</PoliceDelay>
        <PoliceTimeout>600</PoliceTimeout>
        <Sentries>true</Sentries><!-- sentry guns at gates and stations in empire space -->
        <SentriesPerGate>3</SentriesPerGate>
        <SentriesPerStation>2</SentriesPerStation>
        <SentryRange>150000</SentryRange><!-- meters -->
    </crime>

    <sov><!-- sovereignty development indices (Dominion/Crucible rules: one level is 9.6M points, indices decay about a level every 4 days) -->
        <MilitaryPointsPerBountyISK>0.1</MilitaryPointsPerBountyISK><!-- military index points per isk of bounty of npcs killed in the system (before the gain modifier of the current level) -->
        <IndustrialPointsPerM3>1.0</IndustrialPointsPerM3><!-- industrial index points per m3 of ore and ice mined in the system (before the gain modifier) -->
        <DevIndexDecayPerHour>100000</DevIndexDecayPerHour><!-- points per hour; the client draws its level bars with 100000, so change with care -->
    </sov>

    <pos><!-- starbases (Crucible 1.1: fuel blocks, strontium reinforcement, charters in 0.5+ empire space) -->
        <FuelRate>1.0</FuelRate><!-- multiplier on the hourly fuel block, charter and strontium use.  0 = towers run without fuel -->
        <RequireCharters>true</RequireCharters><!-- bool - starbase charters needed in the cargo hold to anchor, and burned hourly, where invControlTowerResources asks for them -->
        <HighSecStandingCheck>true</HighSecStandingCheck><!-- bool - anchoring a tower in empire space needs corp standing to the system's faction of 10 x security -->
        <ConcordAnchorRestriction>true</ConcordAnchorRestriction><!-- bool - no anchoring at 0.8+, and the per-type security limit (no moon mining or reactions in 0.5+) -->
        <KeepTowerSystemsLoaded>true</KeepTowerSystemsLoaded><!-- bool - boot systems with online towers at startup and keep them loaded, so fuel, reinforcement and moon mining run in real time -->
        <MaxCatchUpCycles>720</MaxCatchUpCycles><!-- most hourly tower cycles replayed when a tower's system loads after downtime (720 = 30 days) -->
        <MoonGooSeed>1</MoonGooSeed><!-- seed of the generated moon materials (generated once per moon and saved in moonResources) -->
        <MoonGooEmptyChance>0.5</MoonGooEmptyChance><!-- chance a moon has no materials -->
        <GunsEnabled>true</GunsEnabled><!-- bool - starbase weapons and electronic warfare batteries shoot hostiles on their own -->
        <TowerSnapToMoon>false</TowerSnapToMoon><!-- bool - legacy: anchoring moves the tower to a fixed point at its moon and warps the pilot there -->
    </pos>

    <corp><!-- corporation management (Crucible: 24 hour corporate stasis, share-weighted votes, 30 day office rent bills, 2M isk per corp monthly alliance maintenance) -->
        <StasisHours>24</StasisHours><!-- hours after a member's roles and titles are removed before they may quit or be kicked (the "Prepare to Quit Corp" stasis).  0 = no stasis -->
        <CEOVoteMinSharePercent>5</CEOVoteMinSharePercent><!-- percent of the corporation's shares a member must hold to run for CEO.  0 = no share requirement -->
        <CEOVoteCooldownDays>14</CEOVoteCooldownDays><!-- days after a CEO vote opens before another may be opened -->
        <SanctionDays>7</SanctionDays><!-- days the CEO has to implement a passed sanctionable vote (shares, kick, lockdown) -->
        <EnforceRaceLimit>true</EnforceRaceLimit><!-- bool - applicants must be of a race the corporation allows (CEO's race, all with Ethnic Relations), other races capped at 20% of the member limit per Ethnic Relations level -->
        <JunkReleaseFraction>0.5</JunkReleaseFraction><!-- fee to release impounded corp property, as a fraction of the station's office rental fee -->
        <BillsEnabled>true</BillsEnabled><!-- bool - office rent is billed every 30 days and unpaid offices are impounded; alliances get monthly maintenance bills.  false = offices never expire -->
        <CloseAllianceOnUnpaidBill>true</CloseAllianceOnUnpaidBill><!-- bool - an alliance whose maintenance bill goes overdue is closed -->
        <BillGraceDays>0</BillGraceDays><!-- days after a bill's due date before it counts as unpaid -->
    </corp>

    <war><!-- wars between player corporations and alliances (Crucible: declared by corporation vote or by the alliance executor, hostile 24 hours after declaration, weekly bills, 24 hour grace when a war ends) -->
        <Enabled>true</Enabled><!-- bool - false = no new war declarations, and wars give no free targets to CONCORD -->
        <CorpWarCost>2000000</CorpWarCost><!-- isk - base cost of a corporation's war on a corporation.  cost = base x (wars the declarer has declared + 1) x (wars declared on the target + 1), mutual wars not counted -->
        <AllianceWarCost>50000000</AllianceWarCost><!-- isk - base cost when either side is an alliance -->
        <MaxDeclaredWars>0</MaxDeclaredWars><!-- most wars a corporation or alliance may have declared at once.  0 = no limit -->
        <BillDays>7</BillDays><!-- days between war bills.  the bill is paid by the declaring corporation, or the executor of the declaring alliance; an unpaid bill (also one an alliance without executor can't pay) cancels the war.  wars are only billed while corp bills are enabled -->
        <HistoryDays>30</HistoryDays><!-- days a finished war still shows in the wars lists -->
    </war>

    <alliance><!-- alliance membership (Crucible: accepted applications take 24 hours to become effective, executor chosen by the members' support at downtime) -->
        <JoinDelayHours>24</JoinDelayHours><!-- hours from an accepted application to membership.  0 = the corporation joins at once (old emulator behaviour) -->
        <ExecutorTallyHour>11</ExecutorTallyHour><!-- UTC hour of the daily executor count (EVE downtime): a member corporation supported by at least half of the members becomes executor -->
        <ExecutorMinMemberDays>7</ExecutorMinMemberDays><!-- days a corporation must have been a member before it may declare executor support -->
    </alliance>

    <threads><!-- ignored.  the server main loop is single-threaded by design; these are parsed for compatibility only -->
        <NetworkThreads>2</NetworkThreads>
        <DatabaseThreads>2</DatabaseThreads>
        <WorldThreads>2</WorldThreads>
        <ImageServerThreads>1</ImageServerThreads>
        <ConsoleThreads>1</ConsoleThreads>
    </threads>

    <database>
        <host>database_host</host><!--  must be 'localhost' for socket connection -->
        <username>database_username</username>
        <password>database_password</password>
        <db>database_name</db>
        <port>database_port</port><!-- 3306 default -->
        <ssl>false</ssl><!-- bool   enable ssl for db connection (NOTE: NOT coded. DO NOT USE) -not needed when using socket under linux-->
        <compress>false</compress><!-- bool   compressed protocol for client server communication - not sure if needed. -->
        <useSocket>false</useSocket><!-- bool  use socket connection instead of port (MUST be local)  (SIGPIPE hits on debug code) -->
        <autoReconnect>true</autoReconnect><!-- bool  enable auto Reconnect on lost connection -->
        <dbTimeout>2</dbTimeout><!-- seconds  timeout value for db response, in seconds  default: 2s  **NOT USED** -->
        <pingTime>10</pingTime><!-- minutes  ping db every x minutes  default: 10m  **NOT USED**  hard-coded to 10m -->
    </database>

    <files>
        <logDir>../logs/</logDir>
        <logSettings>../etc/log.ini</logSettings>
        <cacheDir>../server_cache/</cacheDir>
        <imageDir>../image_cache/</imageDir>
        <marketBotSettings>../etc/MarketBot.xml</marketBotSettings>
    </files>

    <net>
        <port>26000</port>
        <!-- Host the CLIENTS use to download portraits/logos from imageServerPort (tcp) on this server.
             Every client downloads every portrait but its own from here, so it must be an address
             the players' machines can reach - usually the same host they put in their /server: argument.
               auto (or empty)     : use the address each client connected to (right for a server that is not behind NAT).
               localhost/127.x.x.x : treated as auto, except inside a docker/podman container where it is sent as is
                                     (then only a client on the docker host itself sees other players' portraits).
               anything else       : sent as is.  Required behind NAT/port forwarding and for containers
                                     (bridge networking): the docker host's LAN ip, public ip or dns name.
             Open/publish imageServerPort to the players as well as port. -->
        <imageServer>127.0.0.1</imageServer>
        <imageServerPort>26001</imageServerPort>
    </net>

</eve-server>
