        <SelfDestructRetryDelay>30</SelfDestructRetryDelay><!-- seconds after aborting a self-destruct before another may be started -->
        <StoreShipWithCargo>false</StoreShipWithCargo><!-- bool - ships stored in a maintenance bay/array may carry cargo (only assembled containers are refused, the Odyssey rule).  Crucible: false (charges only) -->
