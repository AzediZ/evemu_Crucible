    <npc>
        <IdleWander>true</IdleWander><!-- bool  idle belt npcs loosely orbit something in their bubble -->
        <WarpOut>600</WarpOut><!-- sec.  an idle belt/gate spawn group warps together to another belt without a spawn after this long (not while chaining, not while scrambled).  0 = never.  10 min default -->
