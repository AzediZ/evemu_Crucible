        <StackTrace>false</StackTrace><!-- bool  -(en/dis)ables sending StackTrace on client errors -->
        <maxPlayers>250</maxPlayers><!-- max authenticated sessions (incl. character select).  0 = unlimited.  VIP/GM accounts bypass, others get a logon queue position -->
        <idleSleepTime>1000</idleSleepTime><!-- in ms (1 sec default) -->
        <processTic>1.0</processTic><!-- used to slow down server process tics.  <1.0 is faster, >1.0 slower -->
        <MaxThreadReport>10</MaxThreadReport>
        <UseMarketBot>false</UseMarketBot><!-- this is coded in eve gate.  not needed here -->
        <DisableIGB>false</DisableIGB>
        <BulkDataOD>true</BulkDataOD>  <!-- bool  -OD = OnDemand.  false loads data on server startup.  true loads data on first call -->
        <BulkDataAutoVersion>true</BulkDataAutoVersion><!-- bool  -derive the bulk data version from table checksums, so clients refetch dogma data after a db change.  false uses the compiled-in version -->
        <ModuleAutoOff>true</ModuleAutoOff><!-- bool  - automatically deactivate rr-type module when target is full -->
        <ModuleDamageChance>0.1</ModuleDamageChance>  <!-- chance to apply damage to random modules when shields are depleted -->
        <UnloadOnLinkAll>true</UnloadOnLinkAll>  <!-- bool - grouping loaded weapons unloads them (Group All, drag to group, merge).  false refuses with "You cannot group modules loaded with charges" (Crucible) -->
        <ShieldBleedThrough>true</ShieldBleedThrough><!-- bool - below (1 - shieldUniformity) of its shield (25% for most ships, 0 with Tactical Shield Manipulation V), part of a hit leaks to armor: none at the threshold, all of it at 0 shield -->
        <ArmorBleedThrough>false</ArmorBleedThrough><!-- bool - the same leak from armor to structure below (1 - armorUniformity).  not confirmed for Crucible -->
        <T3SkillLoss>true</T3SkillLoss><!-- bool - a strategic cruiser destroyed with its pilot aboard costs one level of one random subsystem skill (Crucible).  not on self-destruct -->
        <AllowNonPublished>true</AllowNonPublished>
        <BountyPayoutDelayed>true</BountyPayoutDelayed><!-- bool - pay npc bounties on the system timer as one 'Bounty Prizes' journal entry listing the kills (Crucible), or immediately per kill.  default changed to true; set false for the old per-kill payouts -->
        <FleetShareDelayed>true</FleetShareDelayed><!-- bool - switch to put fleet bounty shares in system bounty timer (vs immediate), if enabled -->
        <BountyPayoutTimer>20</BountyPayoutTimer><!-- time for system bounty timer to run (in minutes - 20m default (Crucible) - 255 max) -->
        <!-- LoadOldMissions not completely working yet.....AgentMgrService::Handle_GetMyJournalDetails() will need work to implement this. -->
        <LoadOldMissions>false</LoadOldMissions><!-- bool - allow display of expired/completed missions in journal -->
        <AsteroidsOnDScan>true</AsteroidsOnDScan><!-- bool - show asteroids on directional scanner -->
        <CargoMassAdditive>false</CargoMassAdditive><!-- bool - add mass of cargo to ship's mass (will effect mobility) -->
        <TraderJoe>true</TraderJoe><!-- bool - enables the market bot to automatically buy and sell items on the market-->
    </server>

